<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Refit" Version="15.0.0" />
    <PackageReference Include="Refit.HttpClientFactory" Version="15.0.0" />
    <PackageReference Include="Refitter.MSBuild" Version="2.1.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- RefitterGenerateTask already adds these to @(Compile); excluding the implicit glob avoids CS2002 duplicate-file warnings -->
    <Compile Remove="Generated/**/*.cs" />
  </ItemGroup>

</Project>
