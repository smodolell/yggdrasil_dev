{
  "openApiPath": "swagger.json",
  "namespace": "Yggdrasil.ApiClient",
  "contractsNamespace": "Yggdrasil.ApiClient.Contracts",
  "clientsNamespace": "Yggdrasil.ApiClient.Clients",
  "generateContracts": true,
  "generateClients": true,
  "generateMultipleFiles": true,
  "contractsOutputFolder": "./Contracts",
  "outputFolder": "./Clients",
  "typeAccessibility": "Public",

  // Agrupa tus interfaces usando los [Tags] del controlador (ej: Clientes, Créditos)
  "multipleInterfaces": "ByTag",
  "operationNameTemplate": "{operationName}Async",

  // 1. CONTROL DE NOMBRES DE MÉTODOS (La clave del problema)
  // Fuerza a usar estrictamente el ID de la operación
  "operationNamingStrategy": "OperationId",
  // Modifica el generador interno para que procese correctamente desde el OperationId
  "operationNameGenerator": "SingleClientFromOperationId",
  "secondaryTypeNamingStrategy": "OpenApiExpression",
  "dependencyInjectionSettings": {
    "baseUrl": "",
    // Configura la resiliencia nativa de .NET 9/10 en lugar de las políticas viejas de Polly
    "transientErrorHandler": "HttpResilience"
  },

  "codeGeneratorSettings": {
    "generateCancellationToken": true,
    "dateType": "System.DateTime",
    "dateTimeType": "System.DateTime",
    "arrayType": "System.Collections.Generic.ICollection",
    "dictionaryType": "System.Collections.Generic.IDictionary",

    // 3. ROBUSTEZ DEL CÓDIGO GENERADO
    // Si una propiedad en el Swagger no es requerida, la genera como nullable (int?, string?)
    // evitando errores de deserialización si el JSON viene parcial
    "generateOptionalPropertiesAsNullable": false,
    // Genera los atributos de validación (como [Required], [StringLength]) en los contratos
    "generateDataAnnotations": true,
    // Activa la serialización polimórfica si manejas herencia en tus DTOs financieros
    "usePolymorphicSerialization": true
  }
}