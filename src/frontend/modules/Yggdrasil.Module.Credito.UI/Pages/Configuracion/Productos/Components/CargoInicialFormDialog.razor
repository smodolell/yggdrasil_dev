@using Yggdrasil.Module.Credito.UI.Services.Configuacion
@using Yggdrasil.Module.Credito.UI.Services.Configuacion.DTOs
@using Yggdrasil.Module.Credito.UI.Services.SelectLists
@inject IConfiguracionApi _configuracionApi
@inject ISelectListsApi _selectListsApi

<MudDialog>
    <DialogContent>
        <EditForm Model="_model" OnValidSubmit="SaveSubmit" id="CargoInicialForm">
            <FluentValidator />
            <MudGrid>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Concepto"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Label="Concepto"
                                  For="@(() => _model.Concepto)" />
                </MudItem>
                <MudItem xs="12">
                    <MudSelect T="int?"
                               @bind-Value="_model.TipoMovimientoId"
                               Margin="Margin.Dense"
                               Variant="Variant.Outlined"
                               Label="Tipo Movimiento"
                               Clearable="true"
                               For="@(() => _model.TipoMovimientoId)">
                        @foreach (var item in _listTiposMovimiento)
                        {
                            <MudSelectItem T="int?" Value="@Convert.ToInt32(item.Value)">@item.Text</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="int?"
                               @bind-Value="_model.TipoCalculoId"
                               Margin="Margin.Dense"
                               Variant="Variant.Outlined"
                               Label="Tipo Cálculo">
                        @foreach (var item in _listTipoCalculos)
                        {
                            <MudSelectItem T="int?" Value="@Convert.ToInt32(item.Value)">@item.Text</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="int?"
                               @bind-Value="_model.FormaPagoId"
                               Margin="Margin.Dense"
                               Variant="Variant.Outlined"
                               Label="Forma de Pago"
                               Clearable="true"
                               For="@(() => _model.FormaPagoId)">
                        @foreach (var item in _listFormasPago)
                        {
                            <MudSelectItem T="int?" Value="@Convert.ToInt32(item.Value)">@item.Text</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                @if (_model.TipoCalculoId == 1)
                {
                    <MudItem xs="12" sm="6">
                        <MudNumericField T="decimal"
                                         @bind-Value="_model.Monto"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Label="Monto"
                                         Min="0"
                                         Format="N2" />
                    </MudItem>
                }
                @if (_model.TipoCalculoId == 2)
                {
                    <MudItem xs="12" sm="6">
                        <MudNumericField T="decimal"
                                         @bind-Value="_model.Porcentaje"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Label="Porcentaje (%)"
                                         Min="0"
                                         Max="100"
                                         Format="N4" />
                    </MudItem>
                }
                @if (_model.TipoCalculoId == 3)
                {
                    <MudItem xs="12" sm="6">
                        <MudNumericField T="int"
                                         @bind-Value="_model.EquivaleNroPeriodos"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Label="Equivale Nro Períodos"
                                         Min="0" />
                    </MudItem>
                }
                <MudItem xs="12">
                    <MudSwitch @bind-Value="_model.PermiteEdicion" Label="¿Permite Edición?" Color="Color.Primary" />
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   ButtonType="ButtonType.Submit"
                   StartIcon="@Icons.Material.Filled.Save"
                   form="CargoInicialForm">
            Guardar
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Default"
                   OnClick="Close"
                   StartIcon="@Icons.Material.Filled.Close">
            Cerrar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance? MudDialog { get; set; }
    [Parameter] public int? CargoId { get; set; }
    [Parameter] public int ProductoId { get; set; }

    private CargoInicialEditDto _model = new();
    private List<SelectListItemDto> _listTiposMovimiento = new();
    private List<SelectListItemDto> _listTipoCalculos = new();
    private List<SelectListItemDto> _listFormasPago = new();

    protected override async Task OnInitializedAsync()
    {
        var tiposMovimiento = await _selectListsApi.GetTiposMovimientoAsync();
        _listTiposMovimiento = tiposMovimiento.Data ?? new();

        var formasPago = await _selectListsApi.GetFormasPagoAsync();
        _listFormasPago = formasPago.Data ?? new();

        var tipoCalculos = await _selectListsApi.GetTiposCalculoAsync();
        _listTipoCalculos = tipoCalculos.Data ?? new();


        if (CargoId.HasValue)
        {
            var result = await _configuracionApi.GetCargoInicialById(CargoId.Value);
            _model = result.Data!;
        }
        else
        {
            _model.ProductoId = ProductoId;
        }
    }

    private async Task SaveSubmit()
    {
        try
        {
            var result = await _configuracionApi.SaveCargoInicial(_model);
            _snackbarService.Add(result.Message, Severity.Success);
            MudDialog?.Close(DialogResult.Ok(true));
        }
        catch (YggdrasilApiException ex)
        {
            _snackbarService.Add(ex.Message, Severity.Error);
        }
    }

    private void Close() => MudDialog?.Close(DialogResult.Cancel());
}
