@using Yggdrasil.Module.Credito.UI.Services.Configuacion
@using Yggdrasil.Module.Credito.UI.Services.Configuacion.DTOs
@using Yggdrasil.Module.Credito.UI.Services.SelectLists
@inject IConfiguracionApi _configuracionApi
@inject ISelectListsApi _selectListsApi

<EditForm Model="_model" OnValidSubmit="SaveSubmit" id="ProductoCreateForm">
    <FluentValidator />

    <MudPaper Outlined="true" Class="pa-4 mb-4">
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudSelect T="int?"
                           @bind-Value="_model.EmpresaId"
                           Margin="Margin.Dense"
                           Variant="Variant.Outlined"
                           Label="Empresa"
                           For="@(() => _model.EmpresaId)">
                    @foreach (var item in _listEmpresas)
                    {
                        <MudSelectItem T="int?" Value="@Convert.ToInt32(item.Value)">@item.Text</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="int?"
                           @bind-Value="_model.MonedaId"
                           Margin="Margin.Dense"
                           Variant="Variant.Outlined"
                           Label="Moneda"
                           For="@(() => _model.MonedaId)">
                    @foreach (var item in _listMonedas)
                    {
                        <MudSelectItem T="int?" Value="@Convert.ToInt32(item.Value)">@item.Text</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_model.ClaveProducto"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Label="Clave del Producto"
                              For="@(() => _model.ClaveProducto)" />
            </MudItem>
            <MudItem xs="12" sm="8">
                <MudTextField @bind-Value="_model.NomProducto"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Label="Nombre del Producto"
                              For="@(() => _model.NomProducto)" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_model.Prefijo"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Label="Prefijo"
                              For="@(() => _model.Prefijo)" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_model.Posfijo"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Label="Posfijo"
                              For="@(() => _model.Posfijo)" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="int?"
                           @bind-Value="_model.TipoMovimientoRentaId"
                           Margin="Margin.Dense"
                           Variant="Variant.Outlined"
                           Label="Tipo Movimiento Renta"
                           Clearable="true"
                           For="@(() => _model.TipoMovimientoRentaId)">
                    @foreach (var item in _listTiposMovimiento)
                    {
                        <MudSelectItem T="int?" Value="@Convert.ToInt32(item.Value)">@item.Text</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="int?"
                           @bind-Value="_model.TipoMovimientoMoraId"
                           Margin="Margin.Dense"
                           Variant="Variant.Outlined"
                           Label="Tipo Movimiento Mora"
                           Clearable="true">
                    @foreach (var item in _listTiposMovimiento)
                    {
                        <MudSelectItem T="int?" Value="@Convert.ToInt32(item.Value)">@item.Text</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField T="decimal"
                                 @bind-Value="_model.MoraPorDefecto"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Label="Mora Por Defecto (%)"
                                 Min="0"
                                 Max="100"
                                 Format="N4" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSwitch @bind-Value="_model.Activo" Label="¿Activo?" Color="Color.Primary" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mb-4" Spacing="2">
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Default"
                   OnClick="Cancel"
                   StartIcon="@Icons.Material.Filled.ArrowBack">
            Cancelar
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   ButtonType="ButtonType.Submit"
                   StartIcon="@Icons.Material.Filled.Save">
            Guardar
        </MudButton>
    </MudStack>
</EditForm>

@code {
    private ProductoCreateDto _model = new() { Activo = true };
    private List<SelectListItemDto> _listEmpresas = new();
    private List<SelectListItemDto> _listMonedas = new();
    private List<SelectListItemDto> _listTiposMovimiento = new();

    protected override async Task OnInitializedAsync()
    {
        var empresas = await _selectListsApi.GetEmpresasAsync();
        _listEmpresas = empresas.Data ?? new();

        var monedas = await _selectListsApi.GetMonedasAsync();
        _listMonedas = monedas.Data ?? new();

        var tiposMovimiento = await _selectListsApi.GetTiposMovimientoAsync();
        _listTiposMovimiento = tiposMovimiento.Data ?? new();
    }

    private async Task SaveSubmit()
    {
        try
        {
            var result = await _configuracionApi.CreateProducto(_model);
            _snackbarService.Add(result.Message, Severity.Success);
            _navManager.NavigateTo("." + PageRoute.ProductoEdit + $"/{result.Data}");
        }
        catch (YggdrasilApiException ex)
        {
            await _dialogService.ShowErrorDialog(ex, "Error al crear el producto");
        }
    }

    private void Cancel() => _navManager.NavigateTo("." + PageRoute.ProductosPage);
}
