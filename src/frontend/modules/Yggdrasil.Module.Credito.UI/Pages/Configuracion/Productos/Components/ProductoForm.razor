@using Yggdrasil.Module.Credito.UI.Services.Configuacion
@using Yggdrasil.Module.Credito.UI.Services.Configuacion.DTOs
@using Yggdrasil.Module.Credito.UI.Services.SelectLists
@inject IConfiguracionApi _configuracionApi
@inject ISelectListsApi _selectListsApi

@if (_model != null)
{
    <EditForm Model="_model" OnValidSubmit="SaveSubmit" id="ProductoEditForm">
        <FluentValidator />

        <MudPaper Outlined="true" Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-3">Información General</MudText>
            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="_model.ClaveProducto"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Label="Clave del Producto"
                                  For="@(() => _model.ClaveProducto)" />
                </MudItem>
                <MudItem xs="12" sm="8">
                    <MudTextField @bind-Value="_model.NomProducto"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Label="Nombre del Producto"
                                  For="@(() => _model.NomProducto)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="int?"
                               @bind-Value="_model.EmpresaId"
                               Margin="Margin.Dense"
                               Variant="Variant.Outlined"
                               Label="Empresa"
                               For="@(() => _model.EmpresaId)">
                        @foreach (var item in _listEmpresas)
                        {
                            <MudSelectItem T="int?" Value="@Convert.ToInt32(item.Value)">@item.Text</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField T="int"
                                     @bind-Value="_model.Consecutivo"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Label="Consecutivo"
                                     Min="0" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.Prefijo"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Label="Prefijo"
                                  For="@(() => _model.Prefijo)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.Posfijo"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Label="Posfijo"
                                  For="@(() => _model.Posfijo)" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSwitch @bind-Value="_model.Activo" Label="¿Activo?" Color="Color.Primary" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Outlined="true" Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-3">Movimientos Financieros</MudText>
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudSelect T="int?"
                               @bind-Value="_model.TipoMovimientoRentaId"
                               Margin="Margin.Dense"
                               Variant="Variant.Outlined"
                               Label="Tipo Movimiento Renta"
                               Clearable="true"
                               For="@(() => _model.TipoMovimientoRentaId)">
                        @foreach (var item in _listTiposMovimiento)
                        {
                            <MudSelectItem T="int?" Value="@Convert.ToInt32(item.Value)">@item.Text</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="int?"
                               @bind-Value="_model.TipoMovimientoMoraId"
                               Margin="Margin.Dense"
                               Variant="Variant.Outlined"
                               Label="Tipo Movimiento Mora"
                               Clearable="true">
                        @foreach (var item in _listTiposMovimiento)
                        {
                            <MudSelectItem T="int?" Value="@Convert.ToInt32(item.Value)">@item.Text</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal"
                                     @bind-Value="_model.MoraPorDefecto"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Label="Mora Por Defecto (%)"
                                     Min="0"
                                     Max="100"
                                     Format="N4" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField T="int"
                                     @bind-Value="_model.TipoCotizadorId"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Label="Tipo Cotizador"
                                     Min="0" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Outlined="true" Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-3">Opciones del Producto</MudText>
            <MudGrid>
                <MudItem xs="12">
                    <MudSwitch @bind-Value="_model.PermiteEnganche" Label="¿Permite Enganche?" Color="Color.Primary" />
                </MudItem>
                @if (_model.PermiteEnganche)
                {
                    <MudItem xs="12" sm="4">
                        <MudSelect T="int?"
                                   @bind-Value="_model.TipoMovimientoEngancheId"
                                   Margin="Margin.Dense"
                                   Variant="Variant.Outlined"
                                   Label="Tipo Movimiento Enganche"
                                   Clearable="true"
                                   For="@(() => _model.TipoMovimientoEngancheId)">
                            @foreach (var item in _listTiposMovimiento)
                            {
                                <MudSelectItem T="int?" Value="@Convert.ToInt32(item.Value)">@item.Text</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudNumericField T="decimal"
                                         @bind-Value="_model.RangoEnganche"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Label="Rango Enganche (%)"
                                         Min="0" Max="100" Format="N2" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudNumericField T="decimal"
                                         @bind-Value="_model.PasoEnganche"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Label="Paso Enganche (%)"
                                         Min="0" Max="100" Format="N2" />
                    </MudItem>
                }

                <MudItem xs="12">
                    <MudSwitch @bind-Value="_model.PermiteBallonPayment" Label="¿Permite Balloon Payment?" Color="Color.Primary" />
                </MudItem>
                @if (_model.PermiteBallonPayment)
                {
                    <MudItem xs="12" sm="6">
                        <MudSelect T="int?"
                                   @bind-Value="_model.TipoMovimientoBallonPaymentId"
                                   Margin="Margin.Dense"
                                   Variant="Variant.Outlined"
                                   Label="Tipo Movimiento Balloon Payment"
                                   Clearable="true"
                                   For="@(() => _model.TipoMovimientoBallonPaymentId)">
                            @foreach (var item in _listTiposMovimiento)
                            {
                                <MudSelectItem T="int?" Value="@Convert.ToInt32(item.Value)">@item.Text</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }

                <MudItem xs="12">
                    <MudSwitch @bind-Value="_model.PermitePagosEspeciales" Label="¿Permite Pagos Especiales?" Color="Color.Primary" />
                </MudItem>
                @if (_model.PermitePagosEspeciales)
                {
                    <MudItem xs="12" sm="6">
                        <MudNumericField T="decimal"
                                         @bind-Value="_model.PorcentajeMaximoPagoEspecial"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Label="% Máximo Pago Especial"
                                         Min="0" Max="100" Format="N2" />
                    </MudItem>
                }

                <MudItem xs="12">
                    <MudSwitch @bind-Value="_model.PermiteGraciaCapital" Label="¿Permite Gracia Capital?" Color="Color.Primary" />
                </MudItem>
                @if (_model.PermiteGraciaCapital)
                {
                    <MudItem xs="12" sm="6">
                        <MudNumericField T="int"
                                         @bind-Value="_model.PeriodosGraciaCapital"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Label="Períodos Gracia Capital"
                                         Min="0" />
                    </MudItem>
                }

                <MudItem xs="12">
                    <MudSwitch @bind-Value="_model.PermiteGraciaInteres" Label="¿Permite Gracia Interés?" Color="Color.Primary" />
                </MudItem>
                @if (_model.PermiteGraciaInteres)
                {
                    <MudItem xs="12" sm="6">
                        <MudNumericField T="int"
                                         @bind-Value="_model.PeriodosGraciaInteres"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Label="Períodos Gracia Interés"
                                         Min="0" />
                    </MudItem>
                }

                <MudItem xs="12">
                    <MudSwitch @bind-Value="_model.PermiteTADesdeArchivo" Label="¿Permite TA desde Archivo?" Color="Color.Primary" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudStack Row="true" Justify="Justify.FlexEnd" Class="mb-4">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       ButtonType="ButtonType.Submit"
                       StartIcon="@Icons.Material.Filled.Save">
                Guardar
            </MudButton>
        </MudStack>
    </EditForm>


}

@code {
    [Parameter] public int ProductoId { get; set; }

    private ProductoEditDto? _model;
    private List<SelectListItemDto> _listEmpresas = new();
    private List<SelectListItemDto> _listTiposMovimiento = new();

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try
        {
            var empresas = await _selectListsApi.GetEmpresasAsync();
            _listEmpresas = empresas.Data ?? new();

            var tiposMovimiento = await _selectListsApi.GetTiposMovimientoAsync();
            _listTiposMovimiento = tiposMovimiento.Data ?? new();

            var producto = await _configuracionApi.GetProductoById(ProductoId);
            _model = producto.Data!;
        }
        catch (YggdrasilApiException ex)
        {
            await _dialogService.ShowErrorDialog(ex, "Error al cargar el producto");
        }
    }

    private async Task SaveSubmit()
    {
        if (_model == null) return;
        try
        {
            var result = await _configuracionApi.UpdateProducto(ProductoId, _model);
            await LoadData();
            _snackbarService.Add(result.Message, Severity.Success);
        }
        catch (YggdrasilApiException ex)
        {
            await _dialogService.ShowErrorDialog(ex, "Error al guardar el producto");
        }
    }
}
