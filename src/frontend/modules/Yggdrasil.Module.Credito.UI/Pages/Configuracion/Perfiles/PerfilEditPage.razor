@attribute [Route(PageRoute.PerfilEdit + "/{PerfilId:int?}")]
@attribute [AccessPoint(AppMenu.MenuConfiguracion, "Editar Perfil",AccessPointType.Page)]
@using Yggdrasil.Module.Credito.UI.Pages.Configuracion.Perfiles.Components
<PageHeader Title="Perfiles"
            Description="Cada perfil define qué secciones del sistema se mostrarán al gestionar un cliente, permitiendo adaptar la información según el tipo de cliente o flujo de trabajo"
            Icon="@AppMenu.MenuConfiguracionIcon"/>

<PerfilForm PerfilId="PerfilId"/>
@code {
    [Parameter]
    public int PerfilId { get; set; } = 0;
}
