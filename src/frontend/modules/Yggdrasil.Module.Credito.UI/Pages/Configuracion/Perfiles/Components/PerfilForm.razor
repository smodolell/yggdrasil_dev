@if (_model != null)
{
    <EditForm Model="_model" OnValidSubmit="SaveSubmit" id="MyID">
        <FluentValidator />
        <MudGrid>
            <MudItem xs="12" sm="12" md="12">
                <MudTextField @bind-Value="_model.NomPerfil" Variant="Variant.Outlined" Margin="Margin.Dense" Label="Nombre del Perfil" For="@(() => _model.NomPerfil)"></MudTextField>
            </MudItem>
            <MudItem xs="12" sm="12" md="6">
                <MudSwitch @bind-Value="@_model.Activo" Label="¿Activo?" Color="Color.Primary" />
            </MudItem>
        </MudGrid>
        <MudItem xs="12" sm="12" md="12">
            <MudSimpleTable Dense="true" Outlined="true" Class="mt-3 mb-3" Hover="true" Bordered="true" Striped="true" Style="width:100%">
                <thead>
                    <tr>
                        <th colspan="4">
                            <MudText Typo="Typo.h6">INFORMACIÓN DEL PERFIL</MudText>
                        </th>
                    </tr>
                    <tr>
                        <th>Descripción</th>
                        <th>Alta</th>
                        <th>Edicion</th>
                        <th>Tabs</th>
                    </tr>
                </thead>
                <tbody>
@foreach (SeccionEditDto item in _model.Items)
{
    <tr>
        <td>@item.NomSeccion</td>
        <td>
            <MudStack Row="true" Justify="Justify.Center">
                <MudSwitch @bind-Value="@item.ActivoCreate"
                           ThumbIcon="@(item.ActivoCreate ? Icons.Material.Filled.Done : Icons.Material.Filled.Close)"
                           ThumbIconColor="@(item.ActivoCreate ? Color.Success : Color.Error)"
                           Disabled="!item.IsCreate">
                </MudSwitch>
            </MudStack>
        </td>
        <td>
            <MudStack Row="true" Justify="Justify.Center">
                <MudSwitch @bind-Value="@item.ActivoEdit"
                           ThumbIcon="@(item.ActivoEdit ? Icons.Material.Filled.Done : Icons.Material.Filled.Close)"
                           ThumbIconColor="@(item.ActivoEdit ? Color.Success : Color.Error)"
                           Disabled="!item.IsEdit">
                </MudSwitch>
            </MudStack>
        </td>
        <td>
            <MudStack Row="true" Justify="Justify.Center">
                <MudSwitch @bind-Value="@item.ActivoExtension"
                           ThumbIcon="@(item.ActivoExtension ? Icons.Material.Filled.Done : Icons.Material.Filled.Close)"
                           ThumbIconColor="@(item.ActivoExtension ? Color.Success : Color.Error)"
                           Disabled="!item.IsExtension">
                </MudSwitch>
            </MudStack>
        </td>
    </tr>
}
                </tbody>
            </MudSimpleTable>


        </MudItem>
        <MudItem xs="12" sm="12" md="12">
            <MudStack Row="true" Justify="Justify.FlexEnd">
                <MudButton Variant="Variant.Filled" FullWidth="false"
                           Color="Color.Primary"
                           Size="Size.Medium"
                           ButtonType="ButtonType.Submit"
                           StartIcon="@Icons.Material.Filled.Save">
                    Guardar
                </MudButton>
            </MudStack>
        </MudItem>
    </EditForm>
}


@code {
    [Parameter]
    public int PerfilId { get; set; }
    private PerfilEditDto? _model;

    protected override async Task OnInitializedAsync()
    {
        if (_model == null)
        {
            await InitialData();
        }
    }

    private async Task InitialData()
    {

        try
        {
            var result = await _configuracionApi.GetPerfilByIdAsync(PerfilId);
            _model = result.Data!;
        }
        catch (YggdrasilApiException ex)
        {
            await _dialogService.ShowErrorDialog(ex, "Error al guardar el perfil");
        }

    }

    private async Task SaveSubmit()
    {
        if (_model == null) return;
        try
        {
            var result = await _configuracionApi.SavePerfilAsync(_model);
            PerfilId = result.Data!;
            await InitialData();

            _snackbarService.Add(result.Message, Severity.Success);
        }
        catch (YggdrasilApiException ex)
        {
            await _dialogService.ShowErrorDialog(ex, "Error al guardar el perfil");
        }
    }
}
