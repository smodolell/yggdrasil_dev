@using Yggdrasil.Module.Credito.UI.Services.Configuacion
@inject IConfiguracionApi _configuracionApi;

<MudDialog>
    <DialogContent>
        <MudText Class="mb-4">
            Selecciona un archivo Excel (.xlsx) con los días inhábiles a marcar en el calendario laboral.
        </MudText>
        <MudFileUpload T="IBrowserFile" FilesChanged="OnFileChanged" Accept=".xlsx">
            <CustomContent Context="fileUploadContext">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.CloudUpload"
                           OnClick="@(() => fileUploadContext.OpenFilePickerAsync())">
                    Seleccionar Archivo
                </MudButton>
            </CustomContent>
        </MudFileUpload>
        @if (_archivo != null)
        {
            <MudChip T="string" Class="mt-3" Icon="@Icons.Material.Filled.Description" Color="Color.Primary">
                @_archivo.Name
            </MudChip>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" FullWidth="false"
                   Color="Color.Primary"
                   Size="Size.Medium"
                   Disabled="@(_archivo == null || _importando)"
                   OnClick="Importar"
                   StartIcon="@Icons.Material.Filled.CloudUpload">
            Importar
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   FullWidth="false"
                   Color="Color.Default"
                   Size="Size.Medium"
                   OnClick="@(() => Close())"
                   StartIcon="@Icons.Material.Filled.Close">
            Cerrar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance? MudDialog { get; set; }

    private const long MaxFileSize = 10 * 1024 * 1024;

    private IBrowserFile? _archivo;
    private bool _importando;

    private void OnFileChanged(IBrowserFile file)
    {
        _archivo = file;
    }

    private async Task Importar()
    {
        if (_archivo == null) return;

        _importando = true;
        try
        {
            await using var stream = _archivo.OpenReadStream(MaxFileSize);
            var streamPart = new StreamPart(stream, _archivo.Name, _archivo.ContentType);

            var result = await _configuracionApi.ImportarDiasInhabiles(streamPart);
            _snackbarService.Add(result.Message, Severity.Success);
            MudDialog?.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            _snackbarService.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _importando = false;
        }
    }

    private void Close() => MudDialog?.Close(DialogResult.Ok(false));
}
