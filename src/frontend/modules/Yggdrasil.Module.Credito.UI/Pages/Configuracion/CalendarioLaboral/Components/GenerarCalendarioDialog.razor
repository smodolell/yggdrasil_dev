@using Yggdrasil.Module.Credito.UI.Services.Configuacion
@inject IConfiguracionApi _configuracionApi;

<MudDialog>
    <DialogContent>
        <MudText Class="mb-4">Se generarán los días del calendario laboral para el año indicado.</MudText>
        <MudNumericField @bind-Value="_anio"
                          Label="Año"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Min="2000"
                          Max="2100" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" FullWidth="false"
                   Color="Color.Primary"
                   Size="Size.Medium"
                   Disabled="_generando"
                   OnClick="Generar"
                   StartIcon="@Icons.Material.Filled.Event">
            Generar
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   FullWidth="false"
                   Color="Color.Default"
                   Size="Size.Medium"
                   OnClick="@(() => Close())"
                   StartIcon="@Icons.Material.Filled.Close">
            Cerrar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance? MudDialog { get; set; }

    private int _anio = DateTime.Now.Year;
    private bool _generando;

    private async Task Generar()
    {
        _generando = true;
        try
        {
            var result = await _configuracionApi.CreateCalendarioLaboral(_anio);
            _snackbarService.Add(result.Message, Severity.Success);
            MudDialog?.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            _snackbarService.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _generando = false;
        }
    }

    private void Close() => MudDialog?.Close(DialogResult.Ok(false));
}
