@using Yggdrasil.Module.Credito.UI.Services.Configuacion
@using Yggdrasil.Module.Credito.UI.Services.Configuacion.DTOs
@inject IConfiguracionApi _configuracionApi;

<MudDialog>
    <DialogContent>
        <EditForm Model="_model" OnValidSubmit="UpdateSubmit" id="MyID">
            <FluentValidator />
            <MudGrid>
                <MudItem xs="12" sm="12" md="12">
                    <MudTextField Value="@Fecha.ToString("dd/MM/yyyy")"
                                  ReadOnly="true"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Label="Fecha">
                    </MudTextField>
                </MudItem>
                <MudItem xs="12" sm="12" md="12">
                    <MudSwitch @bind-Value="@_model.EsHabil"
                               Label="¿Es Hábil?" Color="Color.Primary" For="@(() => _model.EsHabil)" />
                </MudItem>
                <MudItem xs="12" sm="12" md="12">
                    <MudTextField @bind-Value="_model.Descripcion"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Lines="2"
                                  Label="Descripción" For="@(() => _model.Descripcion)">
                    </MudTextField>
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" FullWidth="false"
                   Color="Color.Primary"
                   Size="Size.Medium"
                   ButtonType="ButtonType.Submit"
                   StartIcon="@Icons.Material.Filled.Save"
                   form="MyID">
            Guardar
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   FullWidth="false"
                   Color="Color.Default"
                   Size="Size.Medium"
                   ButtonType="ButtonType.Button"
                   OnClick="@(() => Close())"
                   StartIcon="@Icons.Material.Filled.Close">
            Cerrar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance? MudDialog { get; set; }

    [Parameter] public int Id { get; set; }
    [Parameter] public DateTime Fecha { get; set; }
    [Parameter] public bool EsHabil { get; set; }
    [Parameter] public string Descripcion { get; set; } = string.Empty;

    private CalendarioLaboralEditDto _model = new();

    protected override void OnInitialized()
    {
        _model = new CalendarioLaboralEditDto
        {
            EsHabil = EsHabil,
            Descripcion = Descripcion
        };
    }

    private async Task UpdateSubmit()
    {
        try
        {
            var result = await _configuracionApi.UpdateCalendarioLaboral(Id, _model);
            _snackbarService.Add(result.Message, Severity.Success);
            MudDialog?.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            _snackbarService.Add(ex.Message, Severity.Error);
        }
    }

    private void Close() => MudDialog?.Close(DialogResult.Ok(false));
}
