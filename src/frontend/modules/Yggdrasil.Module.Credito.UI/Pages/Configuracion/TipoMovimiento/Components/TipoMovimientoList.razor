@using Yggdrasil.Module.Credito.UI.Services.Configuacion
@using Yggdrasil.Module.Credito.UI.Services.Configuacion.DTOs
@inject IConfiguracionApi _configuracionApi;

<MudDataGrid Outlined="true"
             Dense="true"
             Bordered="true"
             ServerData="GetTableData"
             FixedHeader="true"
             SortMode="SortMode.Single"
             @ref="dataGridRef"
             T="TipoMovimientoListItemDto">
    <ToolBarContent>
        <MudSpacer></MudSpacer>
        <div style="width:300px">
            <MudTextField T="string" @bind-Value="@_searchText" Margin="Margin.Dense" Placeholder="Buscar.."></MudTextField>
        </div>
        <MudIconButton Size="MudBlazor.Size.Medium"
                       Icon="@Icons.Material.Filled.Search"
                       OnClick="()=>dataGridRef.ReloadServerData()"
                       Variant="Variant.Text"
                       Color="Color.Primary">
        </MudIconButton>
        <MudStack Row="true" AlignItems="AlignItems.End">
            <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => AddClick())" Color="Color.Primary">Agregar</MudButton>
        </MudStack>
    </ToolBarContent>
    <Columns>
        <PropertyColumn Title="Clave" Property="x => x.Clave" HeaderStyle="width:50px;" />
        <PropertyColumn Title="Tipo de Movimiento" Property="x => x.NomTipoMovimiento" />
        <TemplateColumn Resizable="false" Title="Activo" HeaderStyle="width:50px;">
            <CellTemplate>
                <MudSwitch Value="context.Item.Activo" T="bool"
                           ValueChanged="v => ChangeActivo(context.Item.Id,v)"
                           Color="Color.Primary"
                           Size="Size.Small">
                </MudSwitch>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn HeaderStyle="white-space:nowrap;width:50px;" StickyRight="true" Resizable="false" Title="Acciones">
            <CellTemplate>
                <MudStack Row="true" Justify="Justify.FlexEnd">
                    <MudIconButton Size="@MudBlazor.Size.Small"
                                   Icon="@Icons.Material.Outlined.Edit"
                                   Color="Color.Primary"
                                   OnClick="()=>EditClick(context.Item.Id)" />
                    <MudIconButton Size="@MudBlazor.Size.Small"
                                   Icon="@Icons.Material.Outlined.Delete"
                                   Color="Color.Error"
                                   OnClick="()=>DeleteClick(context.Item)" />
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="TipoMovimientoListItemDto" />
    </PagerContent>
    <NoRecordsContent>
        <MudText>No hay registros de <strong>Tipo de Movimiento</strong></MudText>
    </NoRecordsContent>
</MudDataGrid>



@code {
    private string? _searchText;

    private MudDataGrid<TipoMovimientoListItemDto> dataGridRef = null!;
    private DialogOptions _optionsDialogs = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };

    private async Task<GridData<TipoMovimientoListItemDto>> GetTableData(GridState<TipoMovimientoListItemDto> gridState, CancellationToken cancellationToken)
    {
        try
        {
            var _pageNumber = (gridState.Page + 1);
            var _sortBy = nameof(TipoMovimientoListItemDto.Id);
            var _sortDescending = true;
            var _sortDefinitions = gridState.SortDefinitions.FirstOrDefault();
            if (_sortDefinitions != null)
            {
                _sortBy = _sortDefinitions.SortBy;
                _sortDescending = _sortDefinitions.Descending;
            }
            var paginatedList = await _configuracionApi.GetTipoMovimientos(
                _searchText,
                _pageNumber,
                gridState.PageSize,
                _sortBy,
                _sortDescending);
            return new GridData<TipoMovimientoListItemDto>()
            {
                TotalItems = paginatedList.Data!.TotalCount,
                Items = paginatedList.Data.Results
            };
        }
        catch (YggdrasilApiException ex)
        {
            await _dialogService.ShowErrorDialog(ex, "Error al cargar movimientos");
            return new GridData<TipoMovimientoListItemDto>
            {
                Items = Array.Empty<TipoMovimientoListItemDto>(),
                TotalItems = 0
            };
        }
   
    }

    private async Task AddClick()
    {
        var parameters = new DialogParameters { };
        var dialog = await _dialogService.ShowAsync<TipoMovimientoFormDialog>("Nuevo Tipo de Movimiento", parameters, _optionsDialogs);
        var result = await dialog.Result;
        if (!result!.Canceled)
        {
            await dataGridRef.ReloadServerData();
        }

    }

    private async Task EditClick(int id)
    {
        var parameters = new DialogParameters { { "TipoMovimientoId", id } };
        var dialog = await _dialogService.ShowAsync<TipoMovimientoFormDialog>("Editar Tipo de Movimiento", parameters, _optionsDialogs);
        var result = await dialog.Result;
        if (!result!.Canceled)
        {
            await dataGridRef.ReloadServerData();
        }

    }

    private async Task DeleteClick(TipoMovimientoListItemDto item)
    {
        await _dialogService.ShowConfirmDialog($"¿Desea eliminar el Tipo de Movimiento {item.NomTipoMovimiento}?", "Eliminar", async (e) =>
        {

            try
            {
                var result = await _configuracionApi.DeleteTipoMovimiento(item.Id);
                await dataGridRef.ReloadServerData();
                _snackbarService.Add(result.Message, Severity.Success);
            }
            catch (Exception ex)
            {
                _snackbarService.Add(ex.Message, Severity.Error);
            }
        });
    }
    private async Task ChangeActivo(int id, bool active)
    {
        try
        {
            var result = await _configuracionApi.ChangeActivoTipoMovimiento(id, new ChangeActivoDto(active));
            await dataGridRef.ReloadServerData();
            _snackbarService.Add(result.Message, Severity.Success);
        
        }
        catch (Exception ex)
        {
            _snackbarService.Add(ex.Message, Severity.Error);
        }
    }

}


