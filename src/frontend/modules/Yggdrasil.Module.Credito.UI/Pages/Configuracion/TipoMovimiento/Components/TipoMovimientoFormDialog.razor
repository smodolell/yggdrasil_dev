@using Yggdrasil.Module.Credito.UI.Services.Configuacion
@using Yggdrasil.Module.Credito.UI.Services.Configuacion.DTOs
@inject IConfiguracionApi _configuracionApi;

<MudDialog>
    <DialogContent>
        <EditForm Model="_model" OnValidSubmit="UpdateSumbit" id="MyID">
            <FluentValidator />
            <MudGrid>
                <MudItem xs="12" sm="12" md="12">
                    <MudTextField @bind-Value="_model.Clave"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Label="Clave" For="@(() => _model.Clave)">
                    </MudTextField>
                </MudItem>
                <MudItem xs="12" sm="12" md="12">
                    <MudTextField @bind-Value="_model.NomTipoMovimiento"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Label="Tipo de Movimiento" For="@(() => _model.NomTipoMovimiento)">
                    </MudTextField>
                </MudItem>
                <MudItem xs="12" sm="12" md="12">
                    <MudSwitch @bind-Value="@_model.GeneraIvaCapital"
                               Label="¿Genera IVA Capital?" Color="Color.Primary" For="@(() => _model.GeneraIvaCapital)" />
                </MudItem>
                <MudItem xs="12" sm="12" md="12">
                    <MudSwitch @bind-Value="@_model.GeneraIvaInteres" Label="¿Genera IVA Interes?" Color="Color.Primary" For="@(() => _model.GeneraIvaInteres)" />
                </MudItem>
                <MudItem xs="12" sm="12" md="12">
                    <MudSwitch @bind-Value="@_model.EsCargoInicial" Label="¿Cargo Inicial?" Color="Color.Primary" For="@(() => _model.EsCargoInicial)" />
                </MudItem>
                <MudItem xs="12" sm="12" md="12">
                    <MudSwitch @bind-Value="@_model.EsConceptoFinanciado" Label="¿Concepto Financiado?" Color="Color.Primary" For="@(() => _model.EsConceptoFinanciado)" />
                </MudItem>
                <MudItem xs="12" sm="12" md="12">
                    <MudSwitch @bind-Value="@_model.Activo" Label="¿Activo?" Color="Color.Primary" />
                </MudItem>
            </MudGrid>


        </EditForm>

    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" FullWidth="false"
                   Color="Color.Primary"
                   Size="Size.Medium"
                   ButtonType="ButtonType.Submit"
                   StartIcon="@Icons.Material.Filled.Save"
                   form="MyID">
            Guardar
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   FullWidth="false"
                   Color="Color.Default"
                   Size="Size.Medium"
                   ButtonType="ButtonType.Button"
                   OnClick="@(() => Close())"
                   StartIcon="@Icons.Material.Filled.Close">
            Cerrar
        </MudButton>
    </DialogActions>
</MudDialog>



@code {
    [CascadingParameter] IMudDialogInstance? MudDialog { get; set; }

    [Parameter] public int? TipoMovimientoId { get; set; }

    private TipoMovimientoEditDto _model = new TipoMovimientoEditDto();


    protected override async Task OnInitializedAsync()
    {
        if (TipoMovimientoId != null)
        {
            var result = await _configuracionApi.GetTipoMovimientoById(TipoMovimientoId ?? 0);
            _model = result.Data!;
        }

    }
    private async Task UpdateSumbit()
    {
        try
        {
            if (TipoMovimientoId != null)
            {
                var result = await _configuracionApi.UpdateTipoMovimiento(TipoMovimientoId.Value, _model);
                _snackbarService.Add(result.Message, Severity.Success);
            }
            else
            {
                var result = await _configuracionApi.CreateTipoMovimiento(_model);
                _snackbarService.Add(result.Message, Severity.Success);
            }
            
            MudDialog?.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            _snackbarService.Add(ex.Message, Severity.Error);
        }
    }

    private void Close() => MudDialog?.Close(DialogResult.Ok(false));
}
