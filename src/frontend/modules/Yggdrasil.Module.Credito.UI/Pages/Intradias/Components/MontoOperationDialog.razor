<MudDialog>
    <DialogContent>
        <EditForm Model="_model" OnValidSubmit="Guardar" id="MontoOperationForm">
            <MudGrid>
                <MudItem xs="12">
                    <MudNumericField T="decimal"
                                     @bind-Value="_model.Monto"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Label="Monto"
                                     Format="N2"
                                     Min="0.01m" />
                </MudItem>
                <MudItem xs="12">
                    <MudDatePicker @bind-Date="_fecha"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Label="@FechaLabel"
                                   ReadOnly="@FechaReadOnly"
                                   Editable="@(!FechaReadOnly)" />
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Medium"
                   ButtonType="ButtonType.Submit"
                   StartIcon="@Icons.Material.Filled.Save"
                   Disabled="_saving"
                   form="MontoOperationForm">
            Aplicar
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Default"
                   Size="Size.Medium"
                   OnClick="Cerrar"
                   StartIcon="@Icons.Material.Filled.Close">
            Cerrar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance? MudDialog { get; set; }
    [Parameter, EditorRequired] public Guid CreditoId { get; set; }
    [Parameter, EditorRequired] public string FechaLabel { get; set; } = "Fecha";
    [Parameter, EditorRequired] public Func<Guid, decimal, DateTime, Task<ApiResponseDto>> OnSubmitAsync { get; set; } = null!;
    [Parameter] public DateTime? FechaValue { get; set; }
    [Parameter] public bool FechaReadOnly { get; set; }

    private MontoModel _model = new();
    private DateTime? _fecha = DateTime.Now;
    private bool _saving;

    protected override void OnInitialized()
    {
        if (FechaValue.HasValue) _fecha = FechaValue.Value;
    }

    private class MontoModel
    {
        public decimal Monto { get; set; }
    }

    private async Task Guardar()
    {
        _saving = true;
        try
        {
            var result = await OnSubmitAsync(CreditoId, _model.Monto, _fecha ?? DateTime.Now);
            _snackbarService.Add(result.Message, Severity.Success);
            MudDialog?.Close(DialogResult.Ok(true));
        }
        catch (YggdrasilApiException ex)
        {
            _snackbarService.Add(ex.GetSnackbarMessage(), Severity.Error);
        }
        catch (Exception ex)
        {
            _snackbarService.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cerrar() => MudDialog?.Close(DialogResult.Ok(false));
}
