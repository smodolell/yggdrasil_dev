<MudDialog>
    <DialogContent>
        <EditForm Model="_model" OnValidSubmit="Guardar" id="CreditoIntraDiaForm">
            <FluentValidator />
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudNumericField T="double"
                                     Value="_model.MontoOtorgado"
                                     ValueChanged="OnMontoOtorgadoChanged"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Label="Monto Otorgado"
                                     Format="N2"
                                     For="@(() => _model.MontoOtorgado)" />
                    <MudNumericField T="double"
                                     @bind-Value="_model.Capital"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Label="Capital"
                                     Format="N2"
                                     ReadOnly="true"
                                     For="@(() => _model.Capital)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_fechaPrimeraRenta"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Label="Fecha Primera Renta"
                                   Editable="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField T="double"
                                     @bind-Value="_model.Tasa"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Label="Tasa %"
                                     Format="N2"
                                     For="@(() => _model.Tasa)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField T="double"
                                     @bind-Value="_model.TasaIva"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Label="Tasa IVA %"
                                     Format="N2"
                                     For="@(() => _model.TasaIva)" />
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Medium"
                   ButtonType="ButtonType.Submit"
                   StartIcon="@Icons.Material.Filled.Save"
                   Disabled="_saving"
                   form="CreditoIntraDiaForm">
            Guardar
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Default"
                   Size="Size.Medium"
                   OnClick="Cerrar"
                   StartIcon="@Icons.Material.Filled.Close">
            Cerrar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance? MudDialog { get; set; }
    [Parameter] public Guid? CreditoId { get; set; }

    private CreditoIntradiaEditDto _model = new();
    private DateTime? _fechaPrimeraRenta = DateTime.Now;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        if (CreditoId.HasValue)
        {
            try
            {
                var result = await _intradiasApi.CobGetCreditoIntraDiaByIdAsync(CreditoId.Value);
                _model = result.Data ?? new CreditoIntradiaEditDto();
                _fechaPrimeraRenta = _model.FechaPrimeraRenta;
            }
            catch (Exception ex)
            {
                await _dialogService.ShowErrorDialog(ex, "Error al cargar el crédito");
                Cerrar();
            }
        }
    }

    private void OnMontoOtorgadoChanged(double value)
    {
        _model.MontoOtorgado = value;
        _model.Capital = value;
    }

    private async Task Guardar()
    {
        _model.FechaPrimeraRenta = _fechaPrimeraRenta ?? DateTime.Now;
        _saving = true;
        try
        {
            var id = CreditoId ?? Guid.NewGuid();
            var result = await _intradiasApi.CobCapturarCreditoIntraDiaAsync(id, _model);
            _snackbarService.Add(result.Message, Severity.Success);
            MudDialog?.Close(DialogResult.Ok(true));
        }
        catch (YggdrasilApiException ex)
        {
            _snackbarService.Add(ex.GetSnackbarMessage(), Severity.Error);
        }
        catch (Exception ex)
        {
            _snackbarService.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cerrar() => MudDialog?.Close(DialogResult.Ok(false));
}
