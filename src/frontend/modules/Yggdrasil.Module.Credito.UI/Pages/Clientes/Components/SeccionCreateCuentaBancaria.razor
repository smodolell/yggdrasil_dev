@attribute [SeccionPersona(SeccionPersonaConstants.CUENTA_BANCARIA_NEW, SeccionPersonaConstants.CUENTA_BANCARIA_NEW_LABEL)]
@implements ISeccionPersonaCreate
@using ResultArdalis = Ardalis.Result.Result

<EditForm Model="@_model" @ref="_editForm">
    <FluentValidator AsyncMode="true" />
    <ValidationSummary></ValidationSummary>
    <MudGrid>

    
        <MudItem xs="12" sm="6" md="6">
            <MudTextField @bind-Value="_model.NroCuentaBancaria"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Label="Número de cuenta"
                          HelperText="(CBU o Nº de cuenta interna)"
                          MaxLength="20"
                          For="@(() => _model.NroCuentaBancaria)">
            </MudTextField>
        </MudItem>
        <MudItem xs="12" sm="6" md="6">
            <MudTextField @bind-Value="_model.AliasCBU"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Label="Alias CBU"
                          HelperText="(opcional, para transferencias más rápidas)"
                          For="@(() => _model.AliasCBU)">
            </MudTextField>
        </MudItem>
        <MudItem xs="12" sm="6" md="6">
            <MudTextField @bind-Value="_model.Cbu"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Label="CBU (Clave Bancaria Uniforme)"
                          MaxLength="22"
                          For="@(() => _model.Cbu)">
            </MudTextField>
        </MudItem>
        <MudItem xs="12" sm="6" md="6">
            <MudSelect Margin="Margin.Dense" T="int?" @bind-Value="_model.BancoId" For="@(() => _model.BancoId)" Label="Bamco" Variant="Variant.Outlined">
                @if (_listBanco != null)
                {
                    @foreach (var item in _listBanco)
                    {
                        <MudSelectItem T="int?" Value="@Convert.ToInt32(item.Value)">@item.Text </MudSelectItem>
                    }
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="6">
            <MudSelect Margin="Margin.Dense" T="int?" @bind-Value="_model.MonedaId" For="@(() => _model.MonedaId)" Label="Moneda" Variant="Variant.Outlined">
                @if (_listMoneda != null)
                {
                    @foreach (var item in _listMoneda)
                    {
                        <MudSelectItem T="int?" Value="@Convert.ToInt32(item.Value)">@item.Text </MudSelectItem>
                    }
                }
            </MudSelect>
        </MudItem>
    </MudGrid>


</EditForm>

@code
{

    [Parameter]
    public EventCallback<(int, bool)> OnValidationChanged { get; set; }

    private CuentaBancariaEditDto _model = new CuentaBancariaEditDto();

    private List<SelectListItemDto>? _listBanco;
    private List<SelectListItemDto>? _listMoneda;
    private EditForm? _editForm;

    protected async override Task OnInitializedAsync()
    {

         if (_listBanco == null)
         {
            var result = await _selectListCatalogoApi.GetBancoSelectListAsync(string.Empty, null);
            _listBanco = result.Data.ToList();
        }
        if (_listMoneda == null)
        {
            var result = await _selectListCatalogoApi.GetMonedaSelectListAsync(string.Empty,null);
            _listMoneda = result.Data.ToList();
        }


    }

    public async Task<ResultArdalis> Create(int personaId)
    {
        _model.PersonaId = personaId;
        var result = await _clientesApi.CreateCuentaBancariaAsync(personaId, _model);
        return ResultArdalis.Success();
    }



    public async Task ValidateAsync()
    {
        // 1. Obtenemos el EditContext desde la referencia del EditForm
        var editContext = _editForm?.EditContext;

        if (editContext != null)
        {
            // 2. Usamos el método de extensión de Blazilla
            // Este método hace 3 cosas:
            // - Dispara la validación síncrona.
            // - Espera las reglas MustAsync.
            // - Retorna true solo si todo pasó.
            bool isValid = await editContext.ValidateAsync();

            if (OnValidationChanged.HasDelegate)
            {
                await OnValidationChanged.InvokeAsync((SeccionPersonaConstants.CUENTA_BANCARIA_NEW, isValid));
            }

        }

    }


}