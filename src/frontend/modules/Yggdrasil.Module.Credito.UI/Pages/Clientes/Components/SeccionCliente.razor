@attribute [SeccionPersona(SeccionPersonaConstants.INFORMACION_CLIENTE, SeccionPersonaConstants.INFORMACION_CLIENTE_LABEL)]
@implements ISeccionPersonaCreate
@implements ISeccionPersonaEdit
@using ResultArdalis = Ardalis.Result.Result

<EditForm Model="@_model" @ref="_editForm">
    <FluentValidator AsyncMode=" true" />
    <MudGrid>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect Margin="Margin.Dense"
                       T="int?"
                       Value="_model.TipoPersonaId"
                       Label="Tipo de Persona"
                       ValueChanged="@((val)=>ChangeTipoPersona(val))"
                       For="@(() => _model.TipoPersonaId)"
                       Variant="Variant.Outlined">
                @if (_listTipoPersona != null)
                {
                    @foreach (var item in _listTipoPersona)
                    {
                        <MudSelectItem T="int?" Value="@Convert.ToInt32(item.Value)">@item.Text </MudSelectItem>
                    }
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudTextField @bind-Value="_model.PrimerNombre"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Label="Primer Nombre"
                          For="@(() => _model.PrimerNombre)">
            </MudTextField>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudTextField @bind-Value="_model.SegundoNombre"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Label="Segundo Nombre"
                          For="@(() => _model.SegundoNombre)">
            </MudTextField>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudTextField @bind-Value="_model.ApellidoPaterno"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Label="Apellido Paterno"
                          For="@(() => _model.ApellidoPaterno)">
            </MudTextField>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudTextField @bind-Value="_model.ApellidoMaterno"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Label="Apellido Materno"
                          For="@(() => _model.ApellidoMaterno)">
            </MudTextField>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudTextField @bind-Value="_model.Rfc"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Label="RFC"
                          For="@(() => _model.Rfc)">
            </MudTextField>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudTextField @bind-Value="_model.Nss"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Label="NSS"
                          For="@(() => _model.Nss)">
            </MudTextField>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudTextField @bind-Value="_model.Curp"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Label="CURP"
                          For="@(() => _model.Curp)">
            </MudTextField>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect Margin="Margin.Dense"
                       T="int?"
                       @bind-Value="_model.GeneroId"
                       Label="Genero"
                       For="@(() => _model.GeneroId)"
                       Variant="Variant.Outlined">
                @if (_listGenero != null)
                {
                    @foreach (var item in _listGenero)
                    {
                        <MudSelectItem T="int?" Value="@Convert.ToInt32(item.Value)">@item.Text </MudSelectItem>
                    }
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker Margin="Margin.Dense"
                           OpenTo="OpenTo.Year"
                           Label="Fecha Nacimiento"
                           Variant="Variant.Outlined"
                           @bind-Date="_model.FechaNacimiento"
                           For="@(() => _model.FechaNacimiento)">
            </MudDatePicker>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect Margin="Margin.Dense" T="int?" @bind-Value="_model.EdoCivilId" Label="Edo. Civil" Variant="Variant.Outlined">
                @if (_listEdoCivil != null)
                {
                    @foreach (var item in _listEdoCivil)
                    {
                        <MudSelectItem T="int?" Value="@Convert.ToInt32(item.Value)">@item.Text </MudSelectItem>
                    }
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="6">
            <MudTextField @bind-Value="_model.Email"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Label="Email"
                          For="@(() => _model.Email)">
            </MudTextField>
        </MudItem>
        @if (_showPersonaJuridica)
        {
            <MudItem xs="12" sm="6" md="3">
                <MudTextField @bind-Value="_model.RazonSocial"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Label="Razón Social"
                              For="@(() => _model.RazonSocial)">
                </MudTextField>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudDatePicker Margin="Margin.Dense"
                               OpenTo="OpenTo.Year"
                               Label="Fecha Contitución"
                               Variant="Variant.Outlined"
                               @bind-Date="_model.FechaConstitucion"
                               For="@(() => _model.FechaConstitucion)">
                </MudDatePicker>
            </MudItem>

        }

    </MudGrid>


</EditForm>

@code
{
    [Parameter]
    public int PersonaId { get; set; }

    [Parameter]
    public EventCallback<(int, bool)> OnValidationChanged { get; set; }

    private ClienteEditDto _model = new ClienteEditDto();

    private List<SelectListItemDto>? _listTipoPersona;
    private List<SelectListItemDto>? _listEdoCivil;
    private List<SelectListItemDto>? _listGenero;


    private bool _showPersonaJuridica = false;
    private EditForm? _editForm;

    protected async override Task OnInitializedAsync()
    {
        if (_listTipoPersona == null)
        {
            var result = await _selectListCreditoApi.GetTipoPersonaSelectListAsync(string.Empty, null);
            _listTipoPersona = result.Data.ToList();
        }

        if (_listEdoCivil == null)
        {
            var result = await _selectListCreditoApi.GetEdoCivilSelectListAsync(string.Empty, null);
            _listEdoCivil = result.Data.ToList();
        }

        if (_listGenero == null)
        {
            var result = await _selectListCreditoApi.GetGeneroSelectListAsync(string.Empty, null);
            _listGenero = result.Data.ToList();
        }

        if (PersonaId != 0)
        {
            var result = await _clientesApi.GetSeccionClienteEditAsync(PersonaId);
            _model = result.Data!;
            _showPersonaJuridica = _showPersonaJuridica =  _model.TipoPersonaId == 1;
        }
    }


    public async Task<ResultArdalis> Create(int personaId)
    {
        _model.PersonaId = personaId;
        var result = await _clientesApi.SaveSeccionClienteEditAsync(personaId, _model);
        return ResultArdalis.Success();
    }

    public async Task<ResultArdalis> Save()
    {
        var result = await _clientesApi.SaveSeccionClienteEditAsync(PersonaId, _model);
        return ResultArdalis.Success();
    }

    public async Task ValidateAsync()
    {
        var editContext = _editForm?.EditContext;

        if (editContext != null)
        {
            bool isValid = await editContext.ValidateAsync();

            if (OnValidationChanged.HasDelegate)
            {
                await OnValidationChanged.InvokeAsync((SeccionPersonaConstants.INFORMACION_CLIENTE, isValid));
            }

        }
    }

    private void ChangeTipoPersona(int? value)
    {
        if (_model == null) return;
        _model.TipoPersonaId = value ?? 0;
        _showPersonaJuridica = _model.TipoPersonaId != null && _model.TipoPersonaId == 1;
    }

}