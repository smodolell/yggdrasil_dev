@attribute [Route(PageRoute.ClienteNew)]
@attribute [AccessPoint(AppMenu.MenuOperacion, "Nuevo Cliente")]
@using Yggdrasil.Module.Credito.UI.Services.Clientes
@using Yggdrasil.Module.Credito.UI.Services.Clientes.DTOs
@using Yggdrasil.Module.Credito.UI.Helpers

@inject IClientesApi _clienteService

<PageHeader Title="Nuevo Cliente" Icon="@AppMenu.MenuOperacionIcon">
    <MudBreadcrumbs Items="_items"></MudBreadcrumbs>
</PageHeader>
@if (_perfiles != null)
{
    <MudCard Outlined="true" Class="mb-1">
        <MudCardHeader>
            <CardHeaderContent>
                <div class="d-flex">
                    <MudIcon Icon="@Icons.Material.Filled.Info" class="mr-3"></MudIcon>
                    <MudText><strong>Perfil de Cliente</strong></MudText>
                </div>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <MudStack Justify="Justify.FlexStart" Row="true">
                @foreach (var item in _perfiles)
                {
                    <MudButton Variant="Variant.Filled" Color="@(item.ButtonDisable? Color.Default: Color.Primary)" Disabled="item.ButtonDisable" OnClick="@(() => SelectComponent(item.PerfilId))">@item.NomPerfil</MudButton>
                }
            </MudStack>
        </MudCardContent>
    </MudCard>

}

@if (_componentes != null)
{
    @foreach (var item in _componentes)
    {
        <MudCard Outlined="true" Class="mb-1">
            <MudCardHeader>
                <CardHeaderContent>
                    <div class="d-flex">
                        <MudIcon Icon="@Utils.GetIconByEstatus(item.IsValid)" Color="@Utils.GetColorByEstatus(item.IsValid)" />
                        <MudText><strong>@item.NomSeccion</strong></MudText>
                    </div>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <DynamicComponent Type="item.TypeComponent"
                                  @ref="item.Ref"
                                  Parameters="@(new Dictionary<string, object>
                                                      {
                                                          ["OnValidationChanged"] = EventCallback.Factory.Create<(int, bool)>(this, HandleValidationChanged)
                                                      }
                                    )">
                </DynamicComponent>


            </MudCardContent>
        </MudCard>

    }
    <MudGrid Class="mt-3">
        <MudItem xs="12" sm="12" md="12">
            <MudStack Row="true" Justify="Justify.FlexEnd">
                <MudButton Variant="Variant.Filled" FullWidth="false"
                           Color="Color.Primary"
                           Size="Size.Medium"
                           ButtonType="ButtonType.Submit"
                           StartIcon="@Icons.Material.Filled.Save"
                           OnClick="@(()=>Save())">
                    Guardar
                </MudButton>
            </MudStack>
        </MudItem>
    </MudGrid>

}


@code {

    private List<SeccionPersonaAssemblyDto>? _componentes;
    private List<PerfilDto>? _perfiles;
    public int PerfilId { get; set; }

    private List<BreadcrumbItem> _items = new List<BreadcrumbItem>
    {
        new BreadcrumbItem("Clientes", href: ("." + PageRoute.ClientesPage), icon: Icons.Material.Filled.Home),
        new BreadcrumbItem("Nuevo Cliente", href: null, icon:AppMenu.MenuOperacionIcon,disabled:true)
    };
    protected override async Task OnInitializedAsync()
    {
        if (_perfiles == null)
        {
            var result = await _clienteService.GetPerfilesActivosAsync();
            _perfiles = result.Data;    
        }
    }


    private async Task SelectComponent(int perfilId)
    {
        var result = await _clienteService.GetSeccionesByPerfilIdAsync(perfilId);

        var secciones = result.Data!.Where(r => r.IsCreate).Select(s => s.SeccionId).ToList();

        _componentes = SeccionPersonaHelper.GetListSeccionByAssembly(this.GetType().Assembly, secciones);

        PerfilId = perfilId;
        if (_perfiles != null)
        {
            _perfiles.ForEach(r => r.ButtonDisable = false);
            var item = _perfiles.FirstOrDefault(r => r.PerfilId == perfilId);
            if (item != null)
            {
                item.ButtonDisable = true;
            }
        }

        StateHasChanged();
    }

    private async Task Save()
    {
        if (_componentes == null) return;

        foreach (var componente in _componentes)
        {
            if (componente.Ref?.Instance is ISeccionPersonaCreate seccionCreate)
            {

                await seccionCreate.ValidateAsync();
            }
        }

        var allValid = _componentes.All(a => a.IsValid);
        if (allValid)
        {
            await _dialogService.ShowConfirmDialog($"¿Desea crear el Cliente?", "SI", async (e) =>
            {
                try
                {
                    var result = await _clienteService.CreatePersonaDefault(new CreatePersonaDefaultDto(PerfilId, DateTime.Now));
                    var personaId = result.Data;
                        foreach (var componente in _componentes)
                        {
                            if (componente.Ref?.Instance is ISeccionPersonaCreate seccionCreate)
                            {
                                var resultComponente = await seccionCreate.Create(personaId);
                                if (resultComponente.IsSuccess)
                                {
                                    _snackbarService.Add(result.Message, Severity.Success);
                                }
                                else
                                {
                                    _snackbarService.Add(result.Errors.FirstOrDefault() ?? "ERROR", Severity.Error);
                                }
                            }
                        }

                        _navManager.NavigateTo("." + PageRoute.ClienteEdit + $"/{personaId}");


                }
                catch (YggdrasilApiException ex)
                {
                    _snackbarService.Add(ex.Message, Severity.Error);
                }
            });

        }
    }

    private void HandleValidationChanged((int Id, bool IsValid) validationData)
    {
        if (_componentes == null) return;
        var oSeccion = _componentes.FirstOrDefault(r => r.SeccionId == validationData.Id);
        if (oSeccion != null)
        {
            oSeccion.IsValid = validationData.IsValid;
        }

    }
}
