@attribute [Route(PageRoute.CreditoDetail + "/{CreditoId:int}")]
@attribute [AccessPoint(AppMenu.MenuOperacion, "Detalle de Crédito", AccessPointType.Page)]
@using Yggdrasil.Module.Credito.UI.Services.Creditos
@using Yggdrasil.Module.Credito.UI.Services.Creditos.DTOs
@using Yggdrasil.Module.Credito.UI.Pages.Creditos.Components
@inject ICreditosApi _creditosApi

<PageHeader Title="@(_detail?.ClaveCredito ?? "Detalle de Crédito")" Icon="@AppMenu.MenuOperacionIcon">
    <MudBreadcrumbs Items="_items"></MudBreadcrumbs>
</PageHeader>

@if (_loadingDetail)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}

@if (_detail != null)
{
    <MudPaper Outlined="true" Class="pa-4 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudText Typo="Typo.h6" Class="font-monospace">@_detail.ClaveCredito</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                    @_detail.NomEstatusCredito
                </MudChip>
                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                    v@(_detail.VersionTabla)
                </MudChip>
            </MudStack>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Outlined.Edit"
                       Size="Size.Small"
                       OnClick="NavigateToEdit">
                Editar
            </MudButton>
        </MudStack>

        <MudGrid Spacing="2">
            <MudItem xs="12" sm="4">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Cliente</MudText>
                <MudText Typo="Typo.body2" Class="font-weight-bold">@_detail.NomCliente</MudText>
                <MudText Typo="Typo.caption">RFC: @_detail.RFC &nbsp;|&nbsp; CURP: @_detail.CURP</MudText>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Producto</MudText>
                <MudText Typo="Typo.body2">@_detail.ClaveProducto — @_detail.NomProducto</MudText>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Moneda / Periodicidad</MudText>
                <MudText Typo="Typo.body2">@_detail.ClaveMoneda (@_detail.NomMoneda) &nbsp;·&nbsp; @_detail.NomPeriodicidad</MudText>
            </MudItem>
        </MudGrid>

        <MudDivider Class="my-3" />

        <MudGrid Spacing="2">
            <MudItem xs="6" sm="3" md="2">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Capital</MudText>
                <MudText Typo="Typo.body1" Class="font-weight-bold">@_detail.Capital.ToString("N2")</MudText>
            </MudItem>
            <MudItem xs="6" sm="3" md="2">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Cap. Financiado</MudText>
                <MudText Typo="Typo.body2">@_detail.CapitalFinanciado.ToString("N2")</MudText>
            </MudItem>
            <MudItem xs="6" sm="3" md="2">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Pago Mensual</MudText>
                <MudText Typo="Typo.body2">@_detail.PagoMensual.ToString("N2")</MudText>
            </MudItem>
            <MudItem xs="6" sm="3" md="2">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Plazo</MudText>
                <MudText Typo="Typo.body2">@_detail.Plazo pagos</MudText>
            </MudItem>
            <MudItem xs="6" sm="3" md="2">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Tasa Base</MudText>
                <MudText Typo="Typo.body2">@_detail.TasaBase.ToString("N4")%</MudText>
            </MudItem>
            <MudItem xs="6" sm="3" md="2">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Tasa Mora</MudText>
                <MudText Typo="Typo.body2">@_detail.TasaBaseMora.ToString("N4")%</MudText>
            </MudItem>
            <MudItem xs="6" sm="3" md="2">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">IVA</MudText>
                <MudText Typo="Typo.body2">@_detail.TasaIva.ToString("N4")%</MudText>
            </MudItem>
        </MudGrid>

        <MudDivider Class="my-3" />

        <MudGrid Spacing="2">
            <MudItem xs="6" sm="3">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Fecha Registro</MudText>
                <MudText Typo="Typo.body2">@_detail.FechaRegistro.ToString("dd/MM/yyyy")</MudText>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Fecha Inicio</MudText>
                <MudText Typo="Typo.body2">@(_detail.FechaInicio?.ToString("dd/MM/yyyy") ?? "—")</MudText>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Fecha Activación</MudText>
                <MudText Typo="Typo.body2">@(_detail.FechaActivacion?.ToString("dd/MM/yyyy") ?? "—")</MudText>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Fecha Terminación</MudText>
                <MudText Typo="Typo.body2">@(_detail.FechaTerminacion?.ToString("dd/MM/yyyy") ?? "—")</MudText>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Outlined="true" Class="mb-4">
        <MudTabs Elevation="0" Rounded="false" PanelClass="pa-4"
                 ActivePanelIndex="_activeTab"
                 ActivePanelIndexChanged="OnTabChangedAsync">

            @* ─── Tab 0: Tabla de Amortización ─────────────────────────────── *@
            <MudTabPanel Text="Tabla de Amortización" Icon="@Icons.Material.Outlined.TableChart">
                @if (_loadingTabla)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                }
                else if (_tablaAmortiza is not null)
                {
                    @if (_tablaAmortiza.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Class="mt-2">No hay tabla de amortización generada.</MudAlert>
                    }
                    else
                    {
                        <MudTable Items="_tablaAmortiza" Dense="true" Outlined="true" Elevation="0"
                                  FixedHeader="true" Height="440px" Class="rounded">
                            <HeaderContent>
                                <MudTh>#</MudTh>
                                <MudTh>Tipo</MudTh>
                                <MudTh Style="text-align:center;">Vencimiento</MudTh>
                                <MudTh Style="text-align:right;">Días</MudTh>
                                <MudTh Style="text-align:right;">Saldo Inicial</MudTh>
                                <MudTh Style="text-align:right;">Capital</MudTh>
                                <MudTh Style="text-align:right;">Interés</MudTh>
                                <MudTh Style="text-align:right;">IVA</MudTh>
                                <MudTh Style="text-align:right; font-weight:700;">Total</MudTh>
                                <MudTh Style="text-align:right;">Saldo Final</MudTh>
                                <MudTh Style="text-align:center;">Proc.</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="#">@context.NoPago</MudTd>
                                <MudTd DataLabel="Tipo">@context.NomTipoMovimiento</MudTd>
                                <MudTd DataLabel="Vencimiento" Style="text-align:center;">
                                    @context.FechaVencimiento.ToString("dd/MM/yyyy")
                                </MudTd>
                                <MudTd DataLabel="Días" Style="text-align:right;">@context.Dias</MudTd>
                                <MudTd DataLabel="Saldo Inicial" Style="text-align:right;">@context.SaldoInicial.ToString("N2")</MudTd>
                                <MudTd DataLabel="Capital" Style="text-align:right;">@context.Capital.ToString("N2")</MudTd>
                                <MudTd DataLabel="Interés" Style="text-align:right;">@context.Interes.ToString("N2")</MudTd>
                                <MudTd DataLabel="IVA" Style="text-align:right;">@context.Iva.ToString("N2")</MudTd>
                                <MudTd DataLabel="Total" Style="text-align:right; font-weight:600;">@context.Total.ToString("N2")</MudTd>
                                <MudTd DataLabel="Saldo Final" Style="text-align:right;">@context.SaldoFinal.ToString("N2")</MudTd>
                                <MudTd DataLabel="Procesado" Style="text-align:center;">
                                    @if (context.Procesado)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@Icons.Material.Outlined.RadioButtonUnchecked" Color="Color.Default" Size="Size.Small" />
                                    }
                                </MudTd>
                            </RowTemplate>
                            <FooterContent>
                                <MudTd colspan="4" Style="font-weight:700; text-align:right;">Totales</MudTd>
                                <MudTd Style="text-align:right;" />
                                <MudTd Style="text-align:right; font-weight:700;">@_tablaAmortiza.Sum(x => x.Capital).ToString("N2")</MudTd>
                                <MudTd Style="text-align:right; font-weight:700;">@_tablaAmortiza.Sum(x => x.Interes).ToString("N2")</MudTd>
                                <MudTd Style="text-align:right; font-weight:700;">@_tablaAmortiza.Sum(x => x.Iva).ToString("N2")</MudTd>
                                <MudTd Style="text-align:right; font-weight:700;">@_tablaAmortiza.Sum(x => x.Total).ToString("N2")</MudTd>
                                <MudTd colspan="2" />
                            </FooterContent>
                        </MudTable>
                    }
                }
            </MudTabPanel>

            @* ─── Tab 1: Movimientos ────────────────────────────────────────── *@
            <MudTabPanel Text="Movimientos" Icon="@Icons.Material.Outlined.SwapHoriz">
                @if (_loadingMovimientos)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                }
                else if (_movimientos is not null)
                {
                    @if (_movimientos.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Class="mt-2">No hay movimientos registrados.</MudAlert>
                    }
                    else
                    {
                        <MudTable Items="_movimientos" Dense="true" Outlined="true" Elevation="0"
                                  FixedHeader="true" Height="440px" Class="rounded">
                            <HeaderContent>
                                <MudTh>#</MudTh>
                                <MudTh>Tipo</MudTh>
                                <MudTh>Descripción</MudTh>
                                <MudTh Style="text-align:center;">Vencimiento</MudTh>
                                <MudTh Style="text-align:right;">Capital</MudTh>
                                <MudTh Style="text-align:right;">Interés</MudTh>
                                <MudTh Style="text-align:right;">IVA</MudTh>
                                <MudTh Style="text-align:right; font-weight:700;">Total</MudTh>
                                <MudTh Style="text-align:right;">Saldo Total</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="#">@context.NoPago</MudTd>
                                <MudTd DataLabel="Tipo">@context.NomTipoMovimiento</MudTd>
                                <MudTd DataLabel="Descripción">@context.DescMovimiento</MudTd>
                                <MudTd DataLabel="Vencimiento" Style="text-align:center;">
                                    @context.FechaVencimiento.ToString("dd/MM/yyyy")
                                </MudTd>
                                <MudTd DataLabel="Capital" Style="text-align:right;">@context.Capital.ToString("N2")</MudTd>
                                <MudTd DataLabel="Interés" Style="text-align:right;">@context.Interes.ToString("N2")</MudTd>
                                <MudTd DataLabel="IVA" Style="text-align:right;">@context.Iva.ToString("N2")</MudTd>
                                <MudTd DataLabel="Total" Style="text-align:right; font-weight:600;">@context.Total.ToString("N2")</MudTd>
                                <MudTd DataLabel="Saldo Total" Style="text-align:right;">@context.SaldoTotal.ToString("N2")</MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                }
            </MudTabPanel>

            @* ─── Tab 2: Pagos ──────────────────────────────────────────────── *@
            <MudTabPanel Text="Pagos" Icon="@Icons.Material.Outlined.Payments">
                @if (_loadingPagos)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                }
                else if (_pagos is not null)
                {
                    @if (_pagos.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Class="mt-2">No hay pagos registrados.</MudAlert>
                    }
                    else
                    {
                        <MudTable Items="_pagos" Dense="true" Outlined="true" Elevation="0"
                                  FixedHeader="true" Height="440px" Class="rounded">
                            <HeaderContent>
                                <MudTh Style="width:44px;" />
                                <MudTh Style="width:44px;" />
                                <MudTh>ID</MudTh>
                                <MudTh>Tipo</MudTh>
                                <MudTh Style="text-align:center;">Fecha Pago</MudTh>
                                <MudTh Style="text-align:right; font-weight:700;">Monto</MudTh>
                                <MudTh Style="text-align:right;">Saldo Favor</MudTh>
                                <MudTh Style="text-align:center;">Estatus</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>
                                    <MudIconButton Size="Size.Small"
                                                   Icon="@(_expandedPagos.Contains(context.Id)
                                                           ? Icons.Material.Filled.ExpandLess
                                                           : Icons.Material.Filled.ExpandMore)"
                                                   Disabled="@(context.Movimientos.Count == 0)"
                                                   OnClick="@(() => TogglePagoExpand(context.Id))" />
                                </MudTd>
                                <MudTd>
                                    <MudTooltip Text="Ver detalle">
                                        <MudIconButton Size="Size.Small"
                                                       Icon="@Icons.Material.Outlined.Pageview"
                                                       Color="Color.Primary"
                                                       OnClick="@(() => OpenPagoDetail(context.Id))" />
                                    </MudTooltip>
                                </MudTd>
                                <MudTd DataLabel="ID" Class="font-monospace">@context.Id</MudTd>
                                <MudTd DataLabel="Tipo">@context.NomTipoPago</MudTd>
                                <MudTd DataLabel="Fecha Pago" Style="text-align:center;">
                                    @context.FechaPago.ToString("dd/MM/yyyy")
                                </MudTd>
                                <MudTd DataLabel="Monto" Style="text-align:right; font-weight:600;">
                                    @context.Monto.ToString("N2")
                                </MudTd>
                                <MudTd DataLabel="Saldo Favor" Style="text-align:right;">
                                    @context.SaldoFavor.ToString("N2")
                                </MudTd>
                                <MudTd DataLabel="Estatus" Style="text-align:center;">
                                    @if (context.Cancelado)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">Cancelado</MudChip>
                                    }
                                    else if (!context.Activo)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">Inactivo</MudChip>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">Activo</MudChip>
                                    }
                                </MudTd>
                            </RowTemplate>
                            <ChildRowContent>
                                @if (_expandedPagos.Contains(context.Id))
                                {
                                    <MudTr>
                                        <MudTd colspan="8" Class="pa-0 pb-2">
                                            <MudTable Items="context.Movimientos" Dense="true" Elevation="0"
                                                      Class="mx-8 mt-1 border rounded" Style="background:var(--mud-palette-background-grey)">
                                                <HeaderContent>
                                                    <MudTh>Mov. ID</MudTh>
                                                    <MudTh Style="text-align:center;">Fecha</MudTh>
                                                    <MudTh Style="text-align:right;">Capital</MudTh>
                                                    <MudTh Style="text-align:right;">Interés</MudTh>
                                                    <MudTh Style="text-align:right;">IVA</MudTh>
                                                    <MudTh Style="text-align:right; font-weight:700;">Total</MudTh>
                                                    <MudTh Style="text-align:center;">Cancelado</MudTh>
                                                </HeaderContent>
                                                <RowTemplate Context="pm">
                                                    <MudTd DataLabel="Mov. ID" Class="font-monospace">@pm.MovimientoId</MudTd>
                                                    <MudTd DataLabel="Fecha" Style="text-align:center;">
                                                        @pm.FechaPago.ToString("dd/MM/yyyy")
                                                    </MudTd>
                                                    <MudTd DataLabel="Capital" Style="text-align:right;">@pm.CapitalPagado.ToString("N2")</MudTd>
                                                    <MudTd DataLabel="Interés" Style="text-align:right;">@pm.InteresPagado.ToString("N2")</MudTd>
                                                    <MudTd DataLabel="IVA" Style="text-align:right;">@pm.IvaPagado.ToString("N2")</MudTd>
                                                    <MudTd DataLabel="Total" Style="text-align:right; font-weight:600;">@pm.TotalPagado.ToString("N2")</MudTd>
                                                    <MudTd DataLabel="Cancelado" Style="text-align:center;">
                                                        @if (pm.Cancelado)
                                                        {
                                                            <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" Size="Size.Small" />
                                                            if (!string.IsNullOrEmpty(pm.MotivoCancelacion))
                                                            {
                                                                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                                                                    @pm.MotivoCancelacion
                                                                </MudText>
                                                            }
                                                        }
                                                    </MudTd>
                                                </RowTemplate>
                                            </MudTable>
                                        </MudTd>
                                    </MudTr>
                                }
                            </ChildRowContent>
                        </MudTable>
                    }
                }
            </MudTabPanel>

        </MudTabs>
    </MudPaper>
}

@code {
    [Parameter] public int CreditoId { get; set; }

    private CreditoDetailDto? _detail;
    private List<TablaAmortizaItemDto>? _tablaAmortiza;
    private List<MovimientoItemDto>? _movimientos;
    private List<PagoItemDto>? _pagos;

    private bool _loadingDetail;
    private bool _loadingTabla;
    private bool _loadingMovimientos;
    private bool _loadingPagos;

    private int _activeTab;
    private readonly HashSet<int> _expandedPagos = new();
    private readonly DialogOptions _pagoDetailOptions = new() { CloseButton = true, MaxWidth = MaxWidth.Large, FullWidth = true };

    private List<BreadcrumbItem> _items = new()
    {
        new BreadcrumbItem("Créditos", href: "." + PageRoute.CreditosPage),
        new BreadcrumbItem("Detalle", href: null, disabled: true)
    };

    protected override async Task OnInitializedAsync()
    {
        _loadingDetail = true;
        _loadingTabla = true;
        try
        {
            var detailTask = _creditosApi.GetCreditoDetail(CreditoId);
            var tablaTask  = _creditosApi.GetTablaAmortiza(CreditoId);
            await Task.WhenAll(detailTask, tablaTask);

            _detail       = detailTask.Result.Content?.Data;
            _tablaAmortiza = tablaTask.Result.Content?.Data ?? [];
        }
        catch (Exception ex)
        {
            await _dialogService.ShowErrorDialog(ex, "Error al cargar detalle de crédito");
        }
        finally
        {
            _loadingDetail = false;
            _loadingTabla  = false;
        }
    }

    private async Task OnTabChangedAsync(int index)
    {
        _activeTab = index;
        switch (index)
        {
            case 1 when _movimientos is null:
                await LoadMovimientos();
                break;
            case 2 when _pagos is null:
                await LoadPagos();
                break;
        }
    }

    private async Task LoadMovimientos()
    {
        _loadingMovimientos = true;
        try
        {
            var response = await _creditosApi.GetMovimientos(CreditoId);
            _movimientos = response.Content?.Data ?? [];
        }
        catch (Exception ex)
        {
            await _dialogService.ShowErrorDialog(ex, "Error al cargar movimientos");
        }
        finally
        {
            _loadingMovimientos = false;
        }
    }

    private async Task LoadPagos()
    {
        _loadingPagos = true;
        try
        {
            var response = await _creditosApi.GetPagos(creditoId: CreditoId);
            _pagos = response.Content?.Data ?? [];
        }
        catch (Exception ex)
        {
            await _dialogService.ShowErrorDialog(ex, "Error al cargar pagos");
        }
        finally
        {
            _loadingPagos = false;
        }
    }

    private void TogglePagoExpand(int pagoId)
    {
        if (!_expandedPagos.Add(pagoId))
            _expandedPagos.Remove(pagoId);
    }

    private async Task OpenPagoDetail(int pagoId)
    {
        var parameters = new DialogParameters { { "PagoId", pagoId } };
        await _dialogService.ShowAsync<PagoDetailDialog>($"Detalle de Pago #{pagoId}", parameters, _pagoDetailOptions);
    }

    private void NavigateToEdit() =>
        _navManager.NavigateTo("." + PageRoute.CreditoEdit + $"/{CreditoId}");
}
