@using Yggdrasil.Module.Credito.UI.Services.Creditos
@using Yggdrasil.Module.Credito.UI.Services.Creditos.DTOs
@using Yggdrasil.Module.Credito.UI.Services.Configuacion
@using Yggdrasil.Module.Credito.UI.Services.Configuacion.DTOs
@inject ICreditosApi _creditosApi
@inject IConfiguracionApi _configuracionApi

<MudDrawer @bind-Open="@_openFilter"
           Fixed="false"
           Width="360px"
           Anchor="Anchor.Right"
           Elevation="0"
           Variant="@DrawerVariant.Temporary"
           Style="border-left: 1px solid var(--mud-palette-lines-default);">
    <MudDrawerHeader Class="align-center justify-space-between border-b pa-4">
        <MudText Typo="Typo.subtitle1" Class="mud-text-primary font-weight-bold">Filtros Avanzados</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="() => _openFilter = false" />
    </MudDrawerHeader>

    <MudDrawerContainer>
        <MudGrid Spacing="3" Class="pa-4">
            <MudItem xs="12">
                <MudSelect T="int?"
                           @bind-Value="_productoId"
                           Margin="Margin.Dense"
                           Variant="Variant.Outlined"
                           Label="Producto"
                           Clearable="true">
                    @if (_listProductos != null)
                    {
                        @foreach (var item in _listProductos)
                        {
                            <MudSelectItem T="int?" Value="@item.Id">@item.NomProducto</MudSelectItem>
                        }
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12">
                <MudDateRangePicker @bind-DateRange="_dateRange"
                                    Label="Fecha de Activación (Rango)"
                                    Margin="Margin.Dense"
                                    Variant="Variant.Outlined"
                                    Clearable="true" />
            </MudItem>

            <MudItem xs="12" Class="d-flex justify-space-between mt-4">
                <MudButton Variant="Variant.Text"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Outlined.ClearAll"
                           OnClick="OnClearFilter"
                           Disabled="_loading">
                    Limpiar
                </MudButton>
                <div class="d-flex gap-2">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               OnClick="OnCancelFilter">
                        Cancelar
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Outlined.FilterAlt"
                               OnClick="ApplyFilters"
                               Disabled="_loading">
                        Aplicar
                    </MudButton>
                </div>
            </MudItem>
        </MudGrid>
    </MudDrawerContainer>
</MudDrawer>

<MudCard Outlined="true" Elevation="0" Class="border-none bg-transparent">
    <MudDataGrid @ref="dataGridRef"
                 T="CreditoListItemDto"
                 ServerData="GetTableData"
                 Dense="true"
                 Outlined="true"
                 Bordered="false"
                 FixedHeader="true"
                 SortMode="SortMode.Single"
                 Loading="_loading"
                 Class="mud-elevation-0 border rounded-lg overflow-hidden">

        <ToolBarContent>
            <div style="width: 100%; max-width: 400px;">
                <MudTextField T="string"
                              Value="_searchText"
                              ValueChanged="OnSearch"
                              Placeholder="Buscar por clave, cliente, RFC..."
                              Adornment="Adornment.Start"
                              Clearable="true"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              AdornmentIcon="@Icons.Material.Outlined.Search"
                              IconSize="Size.Small">
                </MudTextField>
            </div>

            <MudIconButton Icon="@Icons.Material.Outlined.FilterAlt"
                           Class="ms-2"
                           Color="@(_hasActiveFilters ? Color.Primary : Color.Default)"
                           Size="Size.Medium"
                           OnClick="OnFilterClicked" />

            <MudSpacer />

            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudTooltip Text="Actualizar Datos">
                    <MudIconButton Icon="@Icons.Material.Outlined.Refresh"
                                   Size="Size.Small"
                                   Color="Color.Default"
                                   OnClick="RefreshData"
                                   Disabled="_loading" />
                </MudTooltip>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Outlined.Add"
                           Size="Size.Small"
                           OnClick="NuevoClick">
                    Nuevo
                </MudButton>
            </MudStack>
        </ToolBarContent>

        <Columns>
            <PropertyColumn Title="Clave" Property="x => x.ClaveCredito" HeaderStyle="width:140px;" Class="font-monospace" />
            <PropertyColumn Title="Cliente" Property="x => x.NomCliente" />
            <PropertyColumn Title="Producto" Property="x => x.NomProducto" HeaderStyle="width:180px;" />
            <TemplateColumn Title="Capital" HeaderStyle="width:130px; text-align: right;" CellClass="text-right" SortBy="x => x.Capital">
                <CellTemplate>
                    <MudText Typo="Typo.body2">@context.Item.Capital.ToString("N2")</MudText>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Tasa" HeaderStyle="width:90px; text-align: right;" CellClass="text-right">
                <CellTemplate>
                    <MudText Typo="Typo.body2">@context.Item.Tasa.ToString("N4")%</MudText>
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Title="Plazo" Property="x => x.Plazo" HeaderStyle="width:80px; text-align: center;" CellClass="text-center" />
            <PropertyColumn Title="Estatus" Property="x => x.NomEstatusCredito" HeaderStyle="width:140px;" />
            <TemplateColumn Title="Fecha Activación" HeaderStyle="width:150px; text-align: center;" CellClass="text-center" SortBy="x => x.FechaActivacion">
                <CellTemplate>
                    <MudText Typo="Typo.body2">@(context.Item.FechaActivacion?.ToString("dd/MM/yyyy") ?? "-")</MudText>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn HeaderStyle="width:130px; text-align: right;" StickyRight="true" Resizable="false" Title="Acciones">
                <CellTemplate>
                    <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="0">
                        @if (context.Item.EstatusCreditoId != 2)
                        {
                            <MudTooltip Text="Activar crédito">
                                <MudIconButton Size="Size.Small"
                                               Icon="@Icons.Material.Outlined.PlayCircleOutline"
                                               Color="Color.Warning"
                                               OnClick="() => ActivarClick(context.Item.Id)" />
                            </MudTooltip>
                        }
                        <MudTooltip Text="Ver detalle">
                            <MudIconButton Size="Size.Small"
                                           Icon="@Icons.Material.Outlined.Visibility"
                                           Color="Color.Default"
                                           OnClick="() => DetailClick(context.Item.Id)" />
                        </MudTooltip>
                        <MudTooltip Text="Editar">
                            <MudIconButton Size="Size.Small"
                                           Icon="@Icons.Material.Outlined.Edit"
                                           Color="Color.Default"
                                           OnClick="() => EditClick(context.Item.Id)" />
                        </MudTooltip>
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
        </Columns>

        <PagerContent>
            <MudDataGridPager T="CreditoListItemDto" RowsPerPageString="Filas por página:" />
        </PagerContent>

        <NoRecordsContent>
            <div class="pa-8 text-center">
                <MudText Typo="Typo.body1" Class="mud-text-secondary">No se encontraron registros de <strong>Créditos</strong></MudText>
            </div>
        </NoRecordsContent>
    </MudDataGrid>
</MudCard>

@code {
    private string? _searchText;
    private int? _productoId;
    private bool _loading;
    private bool _openFilter;
    private DateRange _dateRange = new();

    private int? _origProductoId;
    private DateRange _origDateRange = new();

    private List<ProductoListItemDto>? _listProductos;

    private MudDataGrid<CreditoListItemDto> dataGridRef = null!;

    private bool _hasActiveFilters => _productoId.HasValue || _dateRange.Start.HasValue;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            var result = await _configuracionApi.GetProductos(size: 100);
            _listProductos = result.Data?.Results;
        }
        catch (Exception ex)
        {
            await _dialogService.ShowErrorDialog(ex, "Error al cargar productos");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task<GridData<CreditoListItemDto>> GetTableData(GridState<CreditoListItemDto> gridState, CancellationToken cancellationToken)
    {
        _loading = true;
        try
        {
            var sortDef = gridState.SortDefinitions.FirstOrDefault();
            var sortColumn = sortDef?.SortBy ?? nameof(CreditoListItemDto.Id);
            var sortDesc = sortDef?.Descending ?? true;

            var result = await _creditosApi.GetCreditos(
                q: _searchText,
                page: gridState.Page + 1,
                pageSize: gridState.PageSize,
                sortColumn: sortColumn,
                sortDesc: sortDesc,
                productoId: _productoId,
                fechaActivacionStart: _dateRange.Start?.Date,
                fechaActivacionEnd: _dateRange.End?.Date.AddDays(1).AddSeconds(-1)
            );

            return new GridData<CreditoListItemDto>
            {
                TotalItems = result.Data?.TotalCount ?? 0,
                Items = result.Data?.Results ?? new List<CreditoListItemDto>()
            };
        }
        catch (Exception ex)
        {
            await _dialogService.ShowErrorDialog(ex, "Error al cargar créditos");
            return new GridData<CreditoListItemDto> { Items = Array.Empty<CreditoListItemDto>(), TotalItems = 0 };
        }
        finally
        {
            _loading = false;
        }
    }

    private void NuevoClick() => _navManager.NavigateTo("." + PageRoute.CreditoNew);
    private void ActivarClick(int id) => _navManager.NavigateTo("." + PageRoute.CreditoActivar + $"/{id}");
    private void DetailClick(int id) => _navManager.NavigateTo("." + PageRoute.CreditoDetail + $"/{id}");
    private void EditClick(int id) => _navManager.NavigateTo("." + PageRoute.CreditoEdit + $"/{id}");

    private async Task RefreshData()
    {
        if (dataGridRef != null) await dataGridRef.ReloadServerData();
    }

    private async Task OnSearch(string? text)
    {
        _searchText = text;
        await RefreshData();
    }

    private void OnFilterClicked()
    {
        _origProductoId = _productoId;
        _origDateRange = _dateRange;
        _openFilter = true;
    }

    private async Task ApplyFilters()
    {
        _openFilter = false;
        await RefreshData();
    }

    private async Task OnClearFilter()
    {
        _productoId = null;
        _dateRange = new DateRange();
        _openFilter = false;
        await RefreshData();
    }

    private void OnCancelFilter()
    {
        _productoId = _origProductoId;
        _dateRange = _origDateRange;
        _openFilter = false;
    }
}
