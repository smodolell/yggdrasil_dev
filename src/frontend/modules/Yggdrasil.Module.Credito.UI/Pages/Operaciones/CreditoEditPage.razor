@attribute [Route(PageRoute.CreditoEdit + "/{CreditoId:int}")]
@attribute [AccessPoint(AppMenu.MenuOperacion, "Editar Crédito", AccessPointType.Page)]
@using Yggdrasil.Module.Credito.UI.Services.Creditos
@using Yggdrasil.Module.Credito.UI.Services.Creditos.DTOs
@using Yggdrasil.Module.Credito.UI.Services.SelectLists
@inject ICreditosApi _creditosApi
@inject ISelectListsApi _selectListsApi

<PageHeader Title="Editar Crédito" Icon="@AppMenu.MenuOperacionIcon">
    <MudBreadcrumbs Items="_items"></MudBreadcrumbs>
</PageHeader>

@if (_model != null)
{
    <EditForm Model="_model" OnValidSubmit="SaveSubmit">
        <FluentValidator />

        <MudPaper Outlined="true" Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-3">Información del Crédito</MudText>
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal"
                                     @bind-Value="_model.Capital"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Label="Capital"
                                     Format="N2"
                                     For="@(() => _model.Capital)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal"
                                     @bind-Value="_model.CapitalFinanciado"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Label="Capital Financiado"
                                     Format="N2" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="int?"
                               @bind-Value="_model.MonedaId"
                               Margin="Margin.Dense"
                               Variant="Variant.Outlined"
                               Label="Moneda"
                               For="@(() => _model.MonedaId)">
                        @foreach (var item in _listMonedas)
                        {
                            <MudSelectItem T="int?" Value="@Convert.ToInt32(item.Value)">@item.Text</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="int?"
                                     @bind-Value="_model.Plazo"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Label="Plazo"
                                     Min="1"
                                     For="@(() => _model.Plazo)" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="int?"
                                     @bind-Value="_model.PeriodicidadId"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Label="Periodicidad ID"
                                     Min="1"
                                     For="@(() => _model.PeriodicidadId)" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Outlined="true" Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-3">Tasas</MudText>
            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal"
                                     @bind-Value="_model.Tasa"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Label="Tasa (%)"
                                     Format="N4" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal"
                                     @bind-Value="_model.PuntosMas"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Label="Puntos +"
                                     Format="N4" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal"
                                     @bind-Value="_model.PuntosPor"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Label="Puntos x"
                                     Format="N4" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal"
                                     @bind-Value="_model.TasaMora"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Label="Tasa Mora (%)"
                                     Format="N4" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal"
                                     @bind-Value="_model.PuntosMasMora"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Label="Puntos + Mora"
                                     Format="N4" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal?"
                                     @bind-Value="_model.TasaIva"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Label="Tasa IVA (%)"
                                     Format="N4" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Outlined="true" Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-3">Fechas</MudText>
            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudDatePicker @bind-Date="_model.FechaAlta"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Label="Fecha Alta"
                                   Editable="true" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudDatePicker @bind-Date="_model.FechaInicio"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Label="Fecha Inicio"
                                   Editable="true" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudDatePicker @bind-Date="_model.FechaPrimeraRenta"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Label="Fecha Primera Renta"
                                   Editable="true" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-4">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Warning"
                       StartIcon="@Icons.Material.Outlined.PlayArrow"
                       OnClick="ActivarCredito"
                       Disabled="_loading">
                Activar Crédito
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       ButtonType="ButtonType.Submit"
                       StartIcon="@Icons.Material.Filled.Save"
                       Disabled="_loading">
                Guardar
            </MudButton>
        </MudStack>
    </EditForm>
}

@code {
    [Parameter] public int CreditoId { get; set; }

    private CreditoEditDto? _model;
    private bool _loading;
    private List<SelectListItemDto> _listMonedas = new();

    private List<BreadcrumbItem> _items = new()
    {
        new BreadcrumbItem("Créditos", href: ("." + PageRoute.CreditosPage)),
        new BreadcrumbItem("Editar Crédito", href: null, disabled: true)
    };

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            var monedasTask = _selectListsApi.GetMonedasAsync();
            var creditoTask = _creditosApi.GetCreditoById(CreditoId);

            await Task.WhenAll(monedasTask, creditoTask);

            _listMonedas = monedasTask.Result.Data ?? new();
            _model = creditoTask.Result.Content?.Data;
        }
        catch (Exception ex)
        {
            await _dialogService.ShowErrorDialog(ex, "Error al cargar crédito");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveSubmit()
    {
        if (_model == null) return;
        _loading = true;
        try
        {
            var result = await _creditosApi.UpdateCredito(CreditoId, _model);
            _snackbarService.Add(result.Content?.Message ?? "Crédito guardado", Severity.Success);
        }
        catch (Exception ex)
        {
            await _dialogService.ShowErrorDialog(ex, "Error al guardar crédito");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ActivarCredito()
    {
        _loading = true;
        try
        {
            var result = await _creditosApi.ActivarCredito(CreditoId);
            _snackbarService.Add(result.Content?.Data!.MessageProcess ?? "Crédito activado correctamente", Severity.Success);
            await LoadData();
        }
        catch (Exception ex)
        {
            await _dialogService.ShowErrorDialog(ex, "Error al activar crédito");
        }
        finally
        {
            _loading = false;
        }
    }
}
