@attribute [Route(PageRoute.CreditoNew)]
@attribute [AccessPoint(AppMenu.MenuOperacion, "Nuevo Crédito", AccessPointType.Page)]
@using Yggdrasil.Module.Credito.UI.Services.Creditos
@using Yggdrasil.Module.Credito.UI.Services.Creditos.DTOs
@using Yggdrasil.Module.Credito.UI.Services.SelectLists
@using Yggdrasil.Module.Credito.UI.Services.Configuacion
@using Yggdrasil.Module.Credito.UI.Services.Configuacion.DTOs
@using Yggdrasil.Module.Credito.UI.Services.Clientes.DTOs
@using Yggdrasil.Module.Credito.UI.Pages.Operaciones.Components
@inject ICreditosApi _creditosApi
@inject ISelectListsApi _selectListsApi
@inject IConfiguracionApi _configuracionApi

<PageHeader Title="Nuevo Crédito" Icon="@AppMenu.MenuOperacionIcon">
    <MudBreadcrumbs Items="_items"></MudBreadcrumbs>
</PageHeader>

@* ── Selector de cliente ─────────────────────────────────────────────────── *@
<MudPaper Outlined="true" Class="pa-4 mb-4">
    <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-3">Seleccionar Cliente</MudText>
    <SelectCliente OnClienteSelected="OnClienteSelected" />

    @if (_clienteSeleccionado != null)
    {
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mt-2 px-1">
            <MudIcon Icon="@Icons.Material.Outlined.Person" Size="Size.Small" Class="mud-text-secondary" />
            <MudText Typo="Typo.body2">
                <strong>@_clienteSeleccionado.NombreCliente</strong>
                @if (!string.IsNullOrWhiteSpace(_clienteSeleccionado.RFC))
                {
                    <span class="mud-text-secondary"> &nbsp;·&nbsp; RFC: @_clienteSeleccionado.RFC</span>
                }
            </MudText>
        </MudStack>
    }
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}

@if (_model != null)
{
    <EditForm Model="_model" OnValidSubmit="Guardar">
        <FluentValidator />

        @* ── Datos del crédito ────────────────────────────────────────────── *@
        <MudPaper Outlined="true" Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-3">Datos del Crédito</MudText>
            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudSelect T="int"
                               @bind-Value="_model.ProductoId"
                               Margin="Margin.Dense"
                               Variant="Variant.Outlined"
                               Label="Producto">
                        <MudSelectItem T="int" Value="0">[ Seleccione ]</MudSelectItem>
                        @foreach (var p in _listProductos)
                        {
                            <MudSelectItem T="int" Value="@p.Id">@p.NomProducto</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="int?"
                               @bind-Value="_model.MonedaId"
                               Margin="Margin.Dense"
                               Variant="Variant.Outlined"
                               Label="Moneda"
                               For="@(() => _model.MonedaId)">
                        <MudSelectItem T="int?" Value="0">[ Seleccione ]</MudSelectItem>
                        @foreach (var item in _listMonedas)
                        {
                            <MudSelectItem T="int?" Value="@Convert.ToInt32(item.Value)">@item.Text</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal"
                                     @bind-Value="_model.Capital"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Label="Capital"
                                     Format="N2"
                                     For="@(() => _model.Capital)" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal"
                                     @bind-Value="_model.CapitalFinanciado"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Label="Capital Financiado"
                                     Format="N2" />
                </MudItem>
                <MudItem xs="12" sm="2">
                    <MudNumericField T="int?"
                                     @bind-Value="_model.Plazo"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Label="Plazo"
                                     Min="1"
                                     For="@(() => _model.Plazo)" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="int?"
                               @bind-Value="_model.PeriodicidadId"
                               Margin="Margin.Dense"
                               Variant="Variant.Outlined"
                               Label="Periodicidad">
                        <MudSelectItem T="int?" Value="null">[ Seleccione ]</MudSelectItem>
                        @foreach (var p in _listPeriodicidades)
                        {
                            <MudSelectItem T="int?" Value="@Convert.ToInt32(p.Value)">@p.Text</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>        
            </MudGrid>
        </MudPaper>

        @* ── Tasas ────────────────────────────────────────────────────────── *@
        <MudPaper Outlined="true" Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-3">Tasas</MudText>
            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal"
                                     @bind-Value="_model.Tasa"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Label="Tasa (%)"
                                     Format="N4" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal"
                                     @bind-Value="_model.PuntosMas"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Label="Puntos +"
                                     Format="N4" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal"
                                     @bind-Value="_model.PuntosPor"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Label="Puntos x"
                                     Format="N4" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal"
                                     @bind-Value="_model.TasaMora"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Label="Tasa Mora (%)"
                                     Format="N4" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal"
                                     @bind-Value="_model.PuntosMasMora"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Label="Puntos + Mora"
                                     Format="N4" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal?"
                                     @bind-Value="_model.TasaIva"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Label="Tasa IVA (%)"
                                     Format="N4" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        @* ── Fechas ───────────────────────────────────────────────────────── *@
        <MudPaper Outlined="true" Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-3">Fechas</MudText>
            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudDatePicker @bind-Date="_model.FechaAlta"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Label="Fecha Alta"
                                   Editable="true" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudDatePicker @bind-Date="_model.FechaInicio"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Label="Fecha Inicio"
                                   Editable="true" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudDatePicker @bind-Date="_model.FechaPrimeraRenta"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Label="Fecha Primera Renta"
                                   Editable="true" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        @* ── Acciones ─────────────────────────────────────────────────────── *@
        <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-4">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Outlined.ArrowBack"
                       OnClick="Regresar"
                       Disabled="_loading">
                Regresar
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       ButtonType="ButtonType.Submit"
                       StartIcon="@Icons.Material.Filled.Save"
                       Disabled="_loading">
                Crear Crédito
            </MudButton>
        </MudStack>
    </EditForm>
}

@code {
    private PersonaListItemDto? _clienteSeleccionado;
    private CreditoEditDto? _model;
    private bool _loading;

    private List<SelectListItemDto> _listMonedas = new();
    private List<SelectListItemDto> _listPeriodicidades = new();
    private List<ProductoListItemDto> _listProductos = new();

    private List<BreadcrumbItem> _items =
    [
        new BreadcrumbItem("Créditos", href: "." + PageRoute.CreditosPage),
        new BreadcrumbItem("Nuevo Crédito", href: null, disabled: true)
    ];

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            var monedasTask = _selectListsApi.GetMonedasAsync();
            var periodicidadesTask = _selectListsApi.GetPeriodicidadAsync();
            var productosTask = _configuracionApi.GetProductos(size: 100);
            await Task.WhenAll(monedasTask, periodicidadesTask, productosTask);

            _listMonedas = monedasTask.Result.Data ?? new();
            _listPeriodicidades = periodicidadesTask.Result.Data ?? new();
            _listProductos = productosTask.Result.Data?.Results?.ToList() ?? new();
        }
        catch (Exception ex)
        {
            await _dialogService.ShowErrorDialog(ex, "Error al cargar datos");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnClienteSelected(PersonaListItemDto cliente)
    {
        _clienteSeleccionado = cliente;
        _model = null;

        if (cliente != null)
            await CargarTemplate(cliente.Id);
    }

    private async Task CargarTemplate(int personaId)
    {
        _loading = true;
        try
        {
            var result = await _creditosApi.GetNewCredito(personaId);
            _model = result.Content?.Data;
        }
        catch (Exception ex)
        {
            await _dialogService.ShowErrorDialog(ex, "Error al cargar plantilla de crédito");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task Guardar()
    {
        if (_model == null) return;
        _loading = true;
        try
        {
            var result = await _creditosApi.CreateCredito(_model);
            var creditoId = result.Content?.Data;
            _snackbarService.Add("Crédito creado correctamente", Severity.Success);

            if (creditoId.HasValue && creditoId.Value > 0)
                _navManager.NavigateTo("." + PageRoute.CreditoDetail + $"/{creditoId.Value}");
            else
                _navManager.NavigateTo("." + PageRoute.CreditosPage);
        }
        catch (Exception ex)
        {
            await _dialogService.ShowErrorDialog(ex, "Error al crear crédito");
        }
        finally
        {
            _loading = false;
        }
    }

    private void Regresar() => _navManager.NavigateTo("." + PageRoute.CreditosPage);
}
