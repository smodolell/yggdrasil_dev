@attribute [Route(PageRoute.CreditoActivar + "/{CreditoId:int}")]
@attribute [AccessPoint(AppMenu.MenuOperacion, "Activar Crédito", AccessPointType.Page)]
@using Yggdrasil.Module.Credito.UI.Services.Creditos
@using Yggdrasil.Module.Credito.UI.Services.Creditos.DTOs
@inject ICreditosApi _creditosApi

<PageHeader Title="Activar Crédito" Icon="@AppMenu.MenuOperacionIcon">
    <MudBreadcrumbs Items="_items"></MudBreadcrumbs>
</PageHeader>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}

@if (_detail != null)
{
    @* ── Resumen del crédito ──────────────────────────────────────────────── *@
    <MudPaper Outlined="true" Class="pa-4 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
            <MudText Typo="Typo.h6" Class="font-monospace">@_detail.ClaveCredito</MudText>
            <MudChip T="string" Size="Size.Small" Color="@EstatusColor" Variant="Variant.Outlined">
                @_detail.NomEstatusCredito
            </MudChip>
        </MudStack>

        <MudGrid Spacing="2">
            <MudItem xs="12" sm="4">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Cliente</MudText>
                <MudText Typo="Typo.body2" Class="font-weight-bold">@_detail.NomCliente</MudText>
                <MudText Typo="Typo.caption">RFC: @_detail.RFC</MudText>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Producto</MudText>
                <MudText Typo="Typo.body2">@_detail.ClaveProducto — @_detail.NomProducto</MudText>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Periodicidad / Moneda</MudText>
                <MudText Typo="Typo.body2">@_detail.NomPeriodicidad &nbsp;·&nbsp; @_detail.ClaveMoneda</MudText>
            </MudItem>

            <MudDivider Class="my-2" />

            <MudItem xs="6" sm="3">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Capital</MudText>
                <MudText Typo="Typo.body1" Class="font-weight-bold">@_detail.Capital.ToString("N2")</MudText>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Pago Mensual</MudText>
                <MudText Typo="Typo.body2">@_detail.PagoMensual.ToString("N2")</MudText>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Plazo</MudText>
                <MudText Typo="Typo.body2">@_detail.Plazo pagos</MudText>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Tasa Base</MudText>
                <MudText Typo="Typo.body2">@_detail.TasaBase.ToString("N4")%</MudText>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Fecha Inicio</MudText>
                <MudText Typo="Typo.body2">@(_detail.FechaInicio?.ToString("dd/MM/yyyy") ?? "—")</MudText>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Primera Renta</MudText>
                <MudText Typo="Typo.body2">@(_detail.FechaPrimeraRenta?.ToString("dd/MM/yyyy") ?? "—")</MudText>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @* ── Primera cuota que se generará ───────────────────────────────────── *@
    @if (_primeraAmortizacion != null)
    {
        <MudPaper Outlined="true" Class="pa-4 mb-4">
            <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-3">
                <MudIcon Icon="@Icons.Material.Outlined.Receipt" Size="Size.Small" Class="me-1" />
                Primera cuota que se generará al activar
            </MudText>

            <MudTable Items="@(new[] { _primeraAmortizacion })" Dense="true" Outlined="true"
                      Elevation="0" Class="rounded">
                <HeaderContent>
                    <MudTh>#</MudTh>
                    <MudTh>Tipo</MudTh>
                    <MudTh Style="text-align:center;">Vencimiento</MudTh>
                    <MudTh Style="text-align:right;">Días</MudTh>
                    <MudTh Style="text-align:right;">Capital</MudTh>
                    <MudTh Style="text-align:right;">Interés</MudTh>
                    <MudTh Style="text-align:right;">IVA</MudTh>
                    <MudTh Style="text-align:right; font-weight:700;">Total</MudTh>
                    <MudTh Style="text-align:right;">Saldo Final</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.NoPago</MudTd>
                    <MudTd>@context.NomTipoMovimiento</MudTd>
                    <MudTd Style="text-align:center;">@context.FechaVencimiento.ToString("dd/MM/yyyy")</MudTd>
                    <MudTd Style="text-align:right;">@context.Dias</MudTd>
                    <MudTd Style="text-align:right;">@context.Capital.ToString("N2")</MudTd>
                    <MudTd Style="text-align:right;">@context.Interes.ToString("N2")</MudTd>
                    <MudTd Style="text-align:right;">@context.Iva.ToString("N2")</MudTd>
                    <MudTd Style="text-align:right; font-weight:600;">@context.Total.ToString("N2")</MudTd>
                    <MudTd Style="text-align:right;">@context.SaldoFinal.ToString("N2")</MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }

    @* ── Resultado post-activación ───────────────────────────────────────── *@
    @if (_resultado != null)
    {
        <MudAlert Severity="@(_resultado.HasError ? Severity.Error : Severity.Success)"
                  Class="mb-4" Elevation="0">
            <MudText Typo="Typo.body1" Class="font-weight-bold">@_resultado.MessageProcess</MudText>
            <MudText Typo="Typo.body2">
                Crédito: <strong>@_resultado.ClaveCredito</strong> (ID: @_resultado.CreditoId)
            </MudText>
        </MudAlert>
    }

    @* ── Acciones ────────────────────────────────────────────────────────── *@
    <MudPaper Outlined="true" Class="pa-4">
        @if (YaActivo)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-3" Elevation="0">
                Este crédito ya se encuentra activo y no puede activarse nuevamente.
            </MudAlert>
        }

        @if (_primeraAmortizacion == null && !_loading)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3" Elevation="0">
                No se encontró tabla de amortización. El crédito debe tener una tabla generada antes de activarse.
            </MudAlert>
        }

        <MudStack Row="true" Justify="Justify.SpaceBetween">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Outlined.ArrowBack"
                       OnClick="Regresar"
                       Disabled="_activando">
                Regresar
            </MudButton>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Warning"
                       StartIcon="@Icons.Material.Outlined.PlayCircleOutline"
                       OnClick="ConfirmarActivacion"
                       Disabled="@(YaActivo || _primeraAmortizacion == null || _activando || _resultado != null)">
                @if (_activando)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                    <span>Activando...</span>
                }
                else
                {
                    <span>Activar Crédito</span>
                }
            </MudButton>
        </MudStack>
    </MudPaper>
}

@code {
    [Parameter] public int CreditoId { get; set; }

    private CreditoDetailDto? _detail;
    private TablaAmortizaItemDto? _primeraAmortizacion;
    private ActivarCreditoResultDto? _resultado;

    private bool _loading;
    private bool _activando;

    private bool YaActivo => _detail?.EstatusCreditoId == 2;
    private Color EstatusColor => YaActivo ? Color.Success : Color.Warning;

    private List<BreadcrumbItem> _items = new()
    {
        new BreadcrumbItem("Créditos", href: "." + PageRoute.CreditosPage),
        new BreadcrumbItem("Activar Crédito", href: null, disabled: true)
    };

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            var detailTask = _creditosApi.GetCreditoDetail(CreditoId);
            var tablaTask  = _creditosApi.GetTablaAmortiza(CreditoId);
            await Task.WhenAll(detailTask, tablaTask);

            _detail = detailTask.Result.Content?.Data;

            var tabla = tablaTask.Result.Content?.Data ?? [];
            _primeraAmortizacion = tabla.FirstOrDefault(r => r.NoPago == 1);
        }
        catch (Exception ex)
        {
            await _dialogService.ShowErrorDialog(ex, "Error al cargar datos del crédito");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ConfirmarActivacion()
    {
        _activando = true;
        try
        {
            var response = await _creditosApi.ActivarCredito(CreditoId);
            _resultado = response.Content?.Data;

            if (_resultado is { HasError: false })
            {
                _snackbarService.Add($"Crédito {_resultado.ClaveCredito} activado correctamente", Severity.Success);
                // Refrescar el detalle para mostrar el nuevo estatus
                var detail = await _creditosApi.GetCreditoDetail(CreditoId);
                _detail = detail.Content?.Data;
            }
        }
        catch (Exception ex)
        {
            await _dialogService.ShowErrorDialog(ex, "Error al activar crédito");
        }
        finally
        {
            _activando = false;
        }
    }

    private void Regresar() => _navManager.NavigateTo("." + PageRoute.CreditosPage);
}
