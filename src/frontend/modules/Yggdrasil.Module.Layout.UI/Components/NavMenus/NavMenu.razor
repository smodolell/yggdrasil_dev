@implements IDisposable
<MudDrawer @bind-Open="_layoutState.NavIsOpen"
           ClipMode="DrawerClipMode.Never"
           Elevation="2">
    <MudDrawerHeader Class="d-flex align-center">
        @if (_themeState.IsDark)
        {
            <MudImage Src="/images/header-logo-dark.png"  Width="170" Height="60" />
        }
        else
        {
            <MudImage Src="/images/header-logo.png"  Width="170" Height="60"/>
        }
    </MudDrawerHeader>
    <MudNavMenu Margin="Margin.Dense" Dense="true" Color="Color.Primary" Rounded="true" Class="pa-2">
        <MudText Typo="Typo.h6" Class="px-4" Style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@_fullName</MudText>
        <MudText Typo="Typo.body2" Class="px-4 mud-text-secondary" Style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@_userName</MudText>
        <MudDivider Class="my-2" />
        @if (NavMenuItems == null)
        {
            <p><em>Cargando...</em></p>
        }
        else
        {
            <NavItemMenu NavMenuItems="NavMenuItems" NavTo="NavTo" />
        }
       @*  <LogoutButton></LogoutButton> *@
    </MudNavMenu>
</MudDrawer>

