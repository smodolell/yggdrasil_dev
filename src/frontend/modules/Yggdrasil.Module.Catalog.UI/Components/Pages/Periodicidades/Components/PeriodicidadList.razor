@using Yggdrasil.Module.Catalog.UI.Services.Catalogos
@using Yggdrasil.Module.Catalog.UI.Services.Catalogos.DTOs
@inject ICatalogosApi _catalogosApi;

<MudDataGrid Outlined="true"
             Dense="true"
             Bordered="true"
             ServerData="GetTableData"
             FixedHeader="true"
             SortMode="SortMode.Single"
             @ref="dataGridRef"
             T="PeriodicidadListItemDto">
    <ToolBarContent>
        <MudSpacer></MudSpacer>
        <div style="width:300px">
            <MudTextField T="string" @bind-Value="@_searchText" Margin="Margin.Dense" Placeholder="Buscar.."></MudTextField>
        </div>
        <MudIconButton Size="MudBlazor.Size.Medium"
                       Icon="@Icons.Material.Filled.Search"
                       OnClick="()=>dataGridRef.ReloadServerData()"
                       Variant="Variant.Text"
                       Color="Color.Primary">
        </MudIconButton>
        <MudStack Row="true" AlignItems="AlignItems.End">
            <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => AddClick())" Color="Color.Primary">Agregar</MudButton>
        </MudStack>
    </ToolBarContent>
    <Columns>
        <PropertyColumn Title="#" Property="x => x.Id" />
        <PropertyColumn Title="Periodiciad" Property="x => x.NomPeriodicidad" />
        <PropertyColumn Title="Clave Corta" Property="x => x.ClavePeriodicidad" />
        <TemplateColumn Resizable="false" Title="Activo">
            <CellTemplate>
                <MudSwitch Value="context.Item.Activo" T="bool"
                           ValueChanged="v => ChangeActivo(context.Item.Id,v)"
                           Color="Color.Primary"
                           Size="Size.Small">
                </MudSwitch>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn HeaderStyle="white-space:nowrap;width:50px;" StickyRight="true" Resizable="false" Title="Acciones">
            <CellTemplate>
                <MudStack Row="true" Justify="Justify.FlexEnd">
                    <MudIconButton Size="@MudBlazor.Size.Small"
                                   Icon="@Icons.Material.Outlined.Edit"
                                   Color="Color.Primary"
                                   OnClick="()=>EditClick(context.Item.Id)" />
                    <MudIconButton Size="@MudBlazor.Size.Small"
                                   Icon="@Icons.Material.Outlined.Delete"
                                   Color="Color.Error"
                                   OnClick="()=>DeleteClick(context.Item)" />
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="PeriodicidadListItemDto" />
    </PagerContent>
    <NoRecordsContent>
        <MudText>No hay registros de <strong>Periodicidades</strong></MudText>
    </NoRecordsContent>
</MudDataGrid>



@code {
    private string? _searchText;

    private MudDataGrid<PeriodicidadListItemDto> dataGridRef = null!;
    private DialogOptions _optionsDialogs = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.Large, FullWidth = true };

    private async Task<GridData<PeriodicidadListItemDto>> GetTableData(GridState<PeriodicidadListItemDto> gridState, CancellationToken cancellationToken)
    {
        var _pageNumber = (gridState.Page + 1);
        var _sortBy = nameof(PeriodicidadListItemDto.Id);
        var _sortDescending = true;
        var _sortDefinitions = gridState.SortDefinitions.FirstOrDefault();
        if (_sortDefinitions != null)
        {
            _sortBy = _sortDefinitions.SortBy;
            _sortDescending = _sortDefinitions.Descending;
        }
        var paginatedList = await _catalogosApi.GetPeriodicidades(
            _searchText,
            _pageNumber,
            gridState.PageSize,
            _sortBy,
            _sortDescending);
        return new GridData<PeriodicidadListItemDto>()
        {
            TotalItems = paginatedList.Data!.TotalCount,
            Items = paginatedList.Data.Results
        };
    }

    private async Task AddClick()
    {
        var parameters = new DialogParameters { };
        var dialog = await _dialogService.ShowAsync<PeriodicidadFormDialog>("Nuevo Periodicidad", parameters, _optionsDialogs);
        var result = await dialog.Result;
        if (!result!.Canceled)
        {
            await dataGridRef.ReloadServerData();
        }

    }

    private async Task EditClick(int id)
    {
        _snackbarService.Add(id +" ", Severity.Warning);
        var parameters = new DialogParameters { { "PeriodicidadId", id } };
        var dialog = await _dialogService.ShowAsync<PeriodicidadFormDialog>("Editar Periodicidad", parameters, _optionsDialogs);
        var result = await dialog.Result;
        if (!result!.Canceled)
        {
            await dataGridRef.ReloadServerData();
        }

    }

    private async Task DeleteClick(PeriodicidadListItemDto item)
    {
        await _dialogService.ShowConfirmDialog($"¿Desea eliminar el Tipo de Movimiento {item.NomPeriodicidad}?", "Eliminar", async (e) =>
        {

            try
            {
                var result = await _catalogosApi.DeletePeriodicidad(item.Id);
                await dataGridRef.ReloadServerData();
                _snackbarService.Add(result.Message, Severity.Success);
            }
            catch (Exception ex)
            {
                _snackbarService.Add(ex.Message, Severity.Error);
            }
        });
    }
    private async Task ChangeActivo(int id, bool active)
    {
    //     var result = await _catalogosApi.ChangeActivo(id, active);
    //     if (result.IsSuccess)
    //     {
    //         await dataGridRef.ReloadServerData();
    //         _snackbarService.Add(result.SuccessMessage, Severity.Success);
    //     }
    //     else
    //     {
    //         _snackbarService.Add(result.Errors.FirstOrDefault() ?? "Error", Severity.Error);
    //     }

    }

}


