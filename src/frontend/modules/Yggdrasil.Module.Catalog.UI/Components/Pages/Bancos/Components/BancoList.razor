<MudDataGrid Outlined="true"
             Dense="true"
             Bordered="true"
             ServerData="GetTableData"
             FixedHeader="true"
             SortMode="SortMode.Single"
             @ref="dataGridRef"
             T="BancoListItemDto">
    <ToolBarContent>
        <MudSpacer></MudSpacer>
        <div style="width:300px">
            <MudTextField T="string"
                          @bind-Value="@_searchText"
                          Margin="Margin.Dense"
                          Clearable="true"
                          Placeholder="Buscar.."></MudTextField>
        </div>
        <MudIconButton Size="MudBlazor.Size.Medium"
                       Icon="@Icons.Material.Filled.Search"
                       OnClick="()=>dataGridRef.ReloadServerData()"
                       Variant="Variant.Text"
                       Color="Color.Primary">
        </MudIconButton>
        <MudStack Row="true" AlignItems="AlignItems.End">
            <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => AddClick())" Color="Color.Primary">Agregar</MudButton>
        </MudStack>
    </ToolBarContent>
    <Columns>
        <PropertyColumn Title="Código BCRA" Property="x => x.CodigoBCRA" StickyLeft="true" />
        <PropertyColumn Title="Banco" Property="x => x.NomBanco" />
        <PropertyColumn Title="CBU Prefix" Property="x => x.CbuPrefix" />
        <TemplateColumn HeaderStyle="white-space:nowrap;width:50px;" StickyRight="true" Resizable="false" Title="Acciones">
            <CellTemplate>
                <MudStack Row="true" Justify="Justify.FlexEnd">
                    <MudIconButton Size="@MudBlazor.Size.Small"
                                   Icon="@Icons.Material.Outlined.Edit"
                                   Color="Color.Primary"
                                   OnClick="()=>EditClick(context.Item.Id)" />
                    <MudIconButton Size="@MudBlazor.Size.Small"
                                   Icon="@Icons.Material.Outlined.Delete"
                                   Color="Color.Error"
                                   OnClick="()=>DeleteClick(context.Item)" />
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="BancoListItemDto" />
    </PagerContent>
    <NoRecordsContent>
        <MudText>No hay registros de <strong>Banco</strong></MudText>
    </NoRecordsContent>
</MudDataGrid>


@code {
    private string? _searchText;

    private MudDataGrid<BancoListItemDto> dataGridRef = null!;
    private DialogOptions _optionsDialogs = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };

    private async Task<GridData<BancoListItemDto>> GetTableData(GridState<BancoListItemDto> gridState, CancellationToken cancellationToken)
    {
        var _pageNumber = (gridState.Page + 1);
        var _sortBy = nameof(BancoListItemDto.NomBanco);
        var _sortDescending = true;
        var _sortDefinitions = gridState.SortDefinitions.FirstOrDefault();
        if (_sortDefinitions != null)
        {
            _sortBy = _sortDefinitions.SortBy;
            _sortDescending = _sortDefinitions.Descending;
        }
        var paginatedList = await _catalogoApi.BancoAsync(_searchText ?? "",
            _pageNumber,
            gridState.PageSize, _sortBy, _sortDescending);
        return new GridData<BancoListItemDto>()
        {
            TotalItems = paginatedList.Data!.TotalCount,
            Items = paginatedList.Data!.Results
        };
    }

    private async Task AddClick()
    {
        var parameters = new DialogParameters { };
        var dialog = await _dialogService.ShowAsync<BancoFormDialog>("Nuevo Banco", parameters, _optionsDialogs);
        var result = await dialog.Result;
        if (!result!.Canceled)
        {
            await dataGridRef.ReloadServerData();
        }

    }

    private async Task EditClick(int id)
    {
        var parameters = new DialogParameters { { "BancoId", id } };
        var dialog = await _dialogService.ShowAsync<BancoFormDialog>("Editar Banco", parameters, _optionsDialogs);
        var result = await dialog.Result;
        if (!result!.Canceled)
        {
            await dataGridRef.ReloadServerData();
        }

    }

    private async Task DeleteClick(BancoListItemDto item)
    {
        await _dialogService.ShowConfirmDialog($"¿Desea eliminar la Banco {item.NomBanco}?", "Eliminar", async (e) =>
        {

            try
            {
                await _catalogoApi.DeleteBancoAsync(item.Id);
                await dataGridRef.ReloadServerData();
                _snackbarService.Add("Banco eliminado correctamente", MudBlazor.Severity.Success);
            }
            catch (Exception ex)
            {
                _snackbarService.Add(ex.Message, MudBlazor.Severity.Error);
            }
        });
    }
}


