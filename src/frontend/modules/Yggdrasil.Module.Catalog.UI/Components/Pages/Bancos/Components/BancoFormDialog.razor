<MudDialog>
    <DialogContent>

        <EditForm Model="_model" OnValidSubmit="SaveSubmit" id="MyID">
            <FluentValidator />
            <MudGrid>
                <MudItem xs="12" sm="12" md="12">
                    <MudTextField @bind-Value="_model.NomBanco"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Label="Nombre del Banco" For="@(() => _model.NomBanco)">
                    </MudTextField>
                </MudItem>
                <MudItem xs="12" sm="12" md="12">
                    <MudTextField @bind-Value="_model.CodigoBCRA"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Label="Código BCRA" For="@(() => _model.CodigoBCRA)">
                    </MudTextField>
                </MudItem>
                <MudItem xs="12" sm="12" md="12">
                    <MudTextField @bind-Value="_model.CbuPrefix"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Label="CBU Prefix" For="@(() => _model.CbuPrefix)">
                    </MudTextField>
                </MudItem>
            </MudGrid>
        </EditForm>


    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" FullWidth="false"
                   Color="Color.Primary"
                   Size="Size.Medium"
                   ButtonType="ButtonType.Submit"
                   StartIcon="@Icons.Material.Filled.Save"
                   form="MyID">
            Guardar
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   FullWidth="false"
                   Color="Color.Default"
                   Size="Size.Medium"
                   ButtonType="ButtonType.Submit"
                   OnClick="@(() => Close())"
                   StartIcon="@Icons.Material.Filled.Close">
            Cerrar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public int BancoId { get; set; }


    [CascadingParameter] IMudDialogInstance? MudDialog { get; set; }

    private BancoEditDto _model = new BancoEditDto();

    protected override async Task OnInitializedAsync()
    {
        if (BancoId != 0)
        {
            await InitialData();
        }

    }

    private async Task InitialData()
    {
        var result = await _catalogoApi.GetBancoByIdAsync(BancoId);
        if (result.Success)
        {
            _model = result.Data!;
        }
    }

    private async Task SaveSubmit()
    {

        try
        {
            if (BancoId == 0)
            {
                var result = await _catalogoApi.CreateBancoAsync(_model);
                _snackbarService.Add(result.Message, Severity.Success);
                MudDialog?.Close(DialogResult.Ok(true));
            }
            else
            {
                await _catalogoApi.UpdateBancoAsync(BancoId, _model);
                _snackbarService.Add("Banco actualizado correctamente", Severity.Success);
                MudDialog?.Close(DialogResult.Ok(true));
            }


        }
        catch (Exception ex)
        {
            _snackbarService.Add(ex.Message, Severity.Error);
        }
    }

    private void Close() => MudDialog?.Close(DialogResult.Ok(false));
}
