@attribute [Route(PageRoute.TasasPage)]
@attribute [AccessPoint(AppMenu.MenuCatalogo, "Tasas")]
@using Yggdrasil.Module.Catalog.UI.Components.Pages.Tasas.Components
@using Yggdrasil.Module.Catalog.UI.Components.Pages.TasasVariables.Components

<PageHeader Title="Tasas" Icon="@AppMenu.MenuCatalogoIcon"></PageHeader>

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-3">
    <MudTabPanel Text="Tasas Fijas" Icon="@Icons.Material.Filled.Percent">
        <TasaList />
    </MudTabPanel>
    <MudTabPanel Text="Tasas IVA" Icon="@Icons.Material.Filled.ReceiptLong">
        <TasaIvaList />
    </MudTabPanel>
    <MudTabPanel Text="Tasas Variables" Icon="@Icons.Material.Filled.TrendingUp">
        <TasaVariableList />
    </MudTabPanel>
</MudTabs>
