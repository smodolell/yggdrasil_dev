<MudCard Outlined="true" Elevation="0" Class="border-none bg-transparent">
    <MudDataGrid T="TipoCreditoListItemDto"
                 ServerData="GetTableData"
                 Dense="true"
                 Outlined="true"
                 Bordered="false"
                 FixedHeader="true"
                 @ref="_dataGridRef"
                 Class="mud-elevation-0 border rounded-lg overflow-hidden">

        <ToolBarContent>
            <div style="width: 100%; max-width: 350px;">
                <MudTextField T="string"
                              @bind-Value="_searchText"
                              Placeholder="Buscar..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Outlined.Search"
                              Clearable="true"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              IconSize="Size.Small"
                              Immediate="true"
                              OnKeyUp="OnSearchKeyUp"
                              OnClearButtonClick="() => _dataGridRef.ReloadServerData()" />
            </div>

            <MudSpacer />

            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudTooltip Text="Actualizar">
                    <MudIconButton Icon="@Icons.Material.Outlined.Refresh"
                                   Size="Size.Small"
                                   OnClick="() => _dataGridRef.ReloadServerData()" />
                </MudTooltip>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Outlined.Add"
                           Size="Size.Small"
                           OnClick="AgregarClick">
                    Agregar
                </MudButton>
            </MudStack>
        </ToolBarContent>

        <Columns>
            <PropertyColumn Title="Clave" Property="x => x.ClaveTipoCredito" HeaderStyle="width:120px;" />
            <PropertyColumn Title="Nombre" Property="x => x.NomTipoCredito" />
            <PropertyColumn Title="Tipo Mov. Renta" Property="x => x.NomTipoMovimientoRenta" />
            <TemplateColumn Title="Activo" HeaderStyle="width:90px;">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Color="@(context.Item.Activo ? Color.Success : Color.Default)">
                        @(context.Item.Activo ? "Activo" : "Inactivo")
                    </MudChip>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn HeaderStyle="width:110px; text-align:right;" StickyRight="true" Resizable="false" Title="Acciones">
                <CellTemplate>
                    <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="0">
                        <MudTooltip Text="Editar">
                            <MudIconButton Size="Size.Small"
                                           Icon="@Icons.Material.Outlined.Edit"
                                           Color="Color.Default"
                                           OnClick="() => EditarClick(context.Item.Id)" />
                        </MudTooltip>
                        <MudTooltip Text="Eliminar">
                            <MudIconButton Size="Size.Small"
                                           Icon="@Icons.Material.Outlined.Delete"
                                           Color="Color.Error"
                                           OnClick="() => EliminarClick(context.Item)" />
                        </MudTooltip>
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
        </Columns>

        <PagerContent>
            <MudDataGridPager T="TipoCreditoListItemDto" />
        </PagerContent>

        <NoRecordsContent>
            <div class="pa-8 text-center">
                <MudText Typo="Typo.body1" Class="mud-text-secondary">No se encontraron <strong>Tipos de Crédito</strong></MudText>
            </div>
        </NoRecordsContent>
    </MudDataGrid>
</MudCard>

@code {
    private MudDataGrid<TipoCreditoListItemDto> _dataGridRef = null!;
    private string? _searchText;

    private readonly DialogOptions _dialogOptions = new()
    {
        CloseButton = true,
        MaxWidth = MaxWidth.Small,
        FullWidth = true
    };

    private async Task<GridData<TipoCreditoListItemDto>> GetTableData(GridState<TipoCreditoListItemDto> gridState, CancellationToken cancellationToken)
    {
        try
        {
            var pageNumber = gridState.Page + 1;
            var result = await _configuracionApi.GetCSTipoCreditosAsync(_searchText ?? string.Empty, pageNumber, gridState.PageSize, string.Empty, null);
            return new GridData<TipoCreditoListItemDto>
            {
                TotalItems = result.Data?.TotalCount ?? 0,
                Items = result.Data?.Results ?? []
            };
        }
        catch (Exception ex)
        {
            await _dialogService.ShowErrorDialog(ex, "Error al cargar tipos de crédito");
            return new GridData<TipoCreditoListItemDto> { TotalItems = 0, Items = [] };
        }
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await _dataGridRef.ReloadServerData();
    }

    private async Task AgregarClick()
    {
        var dialog = await _dialogService.ShowAsync<TipoCreditoFormDialog>("Nuevo Tipo de Crédito", new DialogParameters(), _dialogOptions);
        var result = await dialog.Result;
        if (!result!.Canceled) await _dataGridRef.ReloadServerData();
    }

    private async Task EditarClick(int id)
    {
        var parameters = new DialogParameters { { nameof(TipoCreditoFormDialog.TipoCreditoId), id } };
        var dialog = await _dialogService.ShowAsync<TipoCreditoFormDialog>("Editar Tipo de Crédito", parameters, _dialogOptions);
        var result = await dialog.Result;
        if (!result!.Canceled) await _dataGridRef.ReloadServerData();
    }

    private async Task EliminarClick(TipoCreditoListItemDto item)
    {
        await _dialogService.ShowConfirmDialog(
            $"¿Desea eliminar el tipo de crédito \"{item.NomTipoCredito}\"?",
            "Eliminar",
            async (_) =>
            {
                try
                {
                    await _configuracionApi.DeleteCSTipoCreditoAsync(item.Id);
                    _snackbarService.Add("Tipo de crédito eliminado correctamente", Severity.Success);
                    await _dataGridRef.ReloadServerData();
                }
                catch (Exception ex)
                {
                    await _dialogService.ShowErrorDialog(ex, "Error al eliminar el tipo de crédito");
                }
            });
    }
}
