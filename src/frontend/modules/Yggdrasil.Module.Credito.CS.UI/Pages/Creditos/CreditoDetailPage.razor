@attribute [Route(PageRoute.CreditoDetail + "/{CreditoId:int}")]
@attribute [AccessPoint(AppMenu.MenuOperacion, "Detalle Crédito Simple", Yggdrasil.Blazor.DTOs.AccessPointType.Page)]

<PageHeader Title="Detalle Crédito Simple" Icon="@AppMenu.MenuOperacionIcon">
    <MudBreadcrumbs Items="_items" />
</PageHeader>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="my-4" />
}
else if (_credito != null)
{
    <MudCard Outlined="true" Class="mb-3">
        <MudCardContent>
            <MudGrid>
                <MudItem xs="12" sm="3">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Clave</MudText>
                    <MudText Typo="Typo.h6">@_credito.ClaveCredito</MudText>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Tipo de Crédito</MudText>
                    <MudText Typo="Typo.h6">@_credito.NomTipoCredito</MudText>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Periodicidad</MudText>
                    <MudText Typo="Typo.h6">@_credito.NomPeriodicidad</MudText>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Método de Amortización</MudText>
                    <MudText Typo="Typo.h6">@_credito.NomMetodoArmotizacion</MudText>
                </MudItem>

                <MudItem xs="12" sm="3">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Capital</MudText>
                    <MudText Typo="Typo.h6">@_credito.Capital.ToString("N2")</MudText>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Tasa</MudText>
                    <MudText Typo="Typo.h6">@_credito.Tasa.ToString("N2")%</MudText>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Tasa IVA</MudText>
                    <MudText Typo="Typo.h6">@_credito.TasaIva.ToString("N2")%</MudText>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Plazo</MudText>
                    <MudText Typo="Typo.h6">@_credito.Plazo</MudText>
                </MudItem>

                <MudItem xs="12" sm="3">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Fecha Inicio</MudText>
                    <MudText Typo="Typo.h6">@_credito.FechaInicio.ToString("dd/MM/yyyy")</MudText>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Fecha Primera Renta</MudText>
                    <MudText Typo="Typo.h6">@_credito.FechaPrimeraRenta.ToString("dd/MM/yyyy")</MudText>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Fecha Firma Contrato</MudText>
                    <MudText Typo="Typo.h6">@(_credito.FechaFirmaContrato?.ToString("dd/MM/yyyy") ?? "-")</MudText>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Fecha Activación</MudText>
                    <MudText Typo="Typo.h6">@(_credito.FechaActivacion?.ToString("dd/MM/yyyy") ?? "-")</MudText>
                </MudItem>

                <MudItem xs="12" sm="3">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Estatus</MudText>
                    <MudChip T="string" Color="@EstatusColor(_credito.NomEstatusCredito)" Size="Size.Small" Class="mt-1">@_credito.NomEstatusCredito</MudChip>
                </MudItem>
            </MudGrid>
        </MudCardContent>
        @if (_credito.EstatusCreditoId == 1)
        {
            <MudCardActions>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           StartIcon="@Icons.Material.Filled.CheckCircle"
                           OnClick="ActivarClick">
                    Activar Crédito
                </MudButton>
            </MudCardActions>
        }
    </MudCard>

    <MudTabs Elevation="0" Rounded="true" Outlined="true" Border="true" ApplyEffectsToContainer="true">
        <MudTabPanel Text="Tabla de Amortización">
            <div style="overflow-x:auto;">
            <MudTable Items="_tablaAmortiza" Dense="true" Hover="true" Loading="_loadingTabla" Class="mt-2">
                <HeaderContent>
                    <MudTh>#</MudTh>
                    <MudTh>Fecha Inicial</MudTh>
                    <MudTh>Fecha Final</MudTh>
                    <MudTh>Vencimiento</MudTh>
                    <MudTh Style="text-align:right;">Días</MudTh>
                    <MudTh Style="text-align:right;">Saldo Inicial</MudTh>
                    <MudTh Style="text-align:right;">Capital</MudTh>
                    <MudTh Style="text-align:right;">Interés</MudTh>
                    <MudTh Style="text-align:right;">IVA</MudTh>
                    <MudTh Style="text-align:right;">Total</MudTh>
                    <MudTh Style="text-align:right;">Saldo Final</MudTh>
                    <MudTh>Movimiento</MudTh>
                    <MudTh Style="text-align:center;">Procesado</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.NoPago</MudTd>
                    <MudTd>@context.FechaInicial.ToString("dd/MM/yyyy")</MudTd>
                    <MudTd>@context.FechaFinal.ToString("dd/MM/yyyy")</MudTd>
                    <MudTd>@context.FechaVencimiento.ToString("dd/MM/yyyy")</MudTd>
                    <MudTd Style="text-align:right;">@context.Dias</MudTd>
                    <MudTd Style="text-align:right;">@context.SaldoInicial.ToString("N2")</MudTd>
                    <MudTd Style="text-align:right;">@context.Capital.ToString("N2")</MudTd>
                    <MudTd Style="text-align:right;">@context.Interes.ToString("N2")</MudTd>
                    <MudTd Style="text-align:right;">@context.Iva.ToString("N2")</MudTd>
                    <MudTd Style="text-align:right;">@context.Total.ToString("N2")</MudTd>
                    <MudTd Style="text-align:right;">@context.SaldoFinal.ToString("N2")</MudTd>
                    <MudTd>@context.NomTipoMovimiento</MudTd>
                    <MudTd Style="text-align:center;">
                        <MudIcon Icon="@(context.Procesado ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.RadioButtonUnchecked)"
                                 Color="@(context.Procesado ? Color.Success : Color.Default)"
                                 Size="Size.Small" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-4">No hay tabla de amortización registrada</MudText>
                </NoRecordsContent>
                <FooterContent>
                    <MudTd colspan="6"><MudText Typo="Typo.subtitle2">Total</MudText></MudTd>
                    <MudTd Style="text-align:right;"><MudText Typo="Typo.subtitle2">@_tablaAmortiza.Sum(m => m.Capital).ToString("N2")</MudText></MudTd>
                    <MudTd Style="text-align:right;"><MudText Typo="Typo.subtitle2">@_tablaAmortiza.Sum(m => m.Interes).ToString("N2")</MudText></MudTd>
                    <MudTd Style="text-align:right;"><MudText Typo="Typo.subtitle2">@_tablaAmortiza.Sum(m => m.Iva).ToString("N2")</MudText></MudTd>
                    <MudTd Style="text-align:right;"><MudText Typo="Typo.subtitle2">@_tablaAmortiza.Sum(m => m.Total).ToString("N2")</MudText></MudTd>
                    <MudTd colspan="3"></MudTd>
                </FooterContent>
            </MudTable>
            </div>
        </MudTabPanel>
    </MudTabs>
}

@code {
    [Parameter] public int CreditoId { get; set; }

    private CreditoCsDetailDto? _credito;
    private List<TablaAmortizaCsItemDto> _tablaAmortiza = [];
    private bool _loading;
    private bool _loadingTabla;

    private List<BreadcrumbItem> _items =>
    [
        new BreadcrumbItem("Créditos Simples", href: ("." + PageRoute.CreditosPage), icon: Icons.Material.Filled.Home),
        new BreadcrumbItem("Detalle", href: null, icon: AppMenu.MenuOperacionIcon, disabled: true)
    ];

    protected override async Task OnInitializedAsync() => await CargarDatos();

    private async Task CargarDatos()
    {
        _loading = true;
        try
        {
            var result = await _creditosApi.GetCSCreditoDetailAsync(CreditoId);
            _credito = result.Data;
        }
        catch (Exception ex)
        {
            await _dialogService.ShowErrorDialog(ex, "Error al cargar el crédito");
        }
        finally
        {
            _loading = false;
        }

        await CargarTablaAmortiza();
    }

    private async Task CargarTablaAmortiza()
    {
        _loadingTabla = true;
        try
        {
            var result = await _creditosApi.GetCSTablaAmortizaAsync(CreditoId, null);
            _tablaAmortiza = result.Data?.OrderBy(x => x.NoPago).ToList() ?? [];
        }
        catch (Exception ex)
        {
            await _dialogService.ShowErrorDialog(ex, "Error al cargar la tabla de amortización");
        }
        finally
        {
            _loadingTabla = false;
        }
    }

    private static Color EstatusColor(string? nomEstatus) => nomEstatus?.Trim().ToLowerInvariant() switch
    {
        "activo" => Color.Success,
        "liquidado" => Color.Default,
        "cancelado" => Color.Error,
        "bloqueado" => Color.Warning,
        _ => Color.Default
    };

    private void ActivarClick() => _navManager.NavigateTo("." + PageRoute.CreditoActivar + $"/{CreditoId}");
}
