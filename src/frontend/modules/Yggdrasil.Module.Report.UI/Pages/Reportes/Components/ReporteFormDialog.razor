@using Yggdrasil.ApiClient
@using Yggdrasil.ApiClient.Contracts

@inject IReportesApi _reportesApi;
<MudDialog>
    <DialogContent>

        <EditForm Model="_model" OnValidSubmit="SaveSubmit" id="@_formId">
            <FluentValidator />
            <MudGrid>
                <MudItem xs="12" sm="12" md="12">
                    <MudTextField T="string" @bind-Value="_model.NomReporte"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Label="Nombre del Reporte" For="@(() => _model.NomReporte)">
                    </MudTextField>
                </MudItem>
                <MudItem xs="12" sm="12" md="12">
                    <MudTextField @bind-Value="_model.StoredProcedure"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Label="Procedimiento (Stored Procedure)" For="@(() => _model.StoredProcedure)">
                    </MudTextField>
                </MudItem>
                <MudItem xs="12" sm="12" md="6">
                    <MudSelect @bind-Value="_model.ReporteFormatoId"
                               T="int"
                               Label="Formato de Salida"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               For="@(() => _model.ReporteFormatoId)">
                        <MudSelectItem T="int" Value="1">EXCEL</MudSelectItem>
                        <MudSelectItem T="int" Value="2">TXT</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="12" md="6">
                    <MudCheckBox @bind-Value="_model.Activo"
                                 T="bool"
                                 Label="Activo"
                                 Color="Color.Primary"
                                 For="@(() => _model.Activo)">
                    </MudCheckBox>
                </MudItem>
            </MudGrid>
        </EditForm>


    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" FullWidth="false"
                   Color="Color.Primary"
                   Size="Size.Medium"
                   ButtonType="ButtonType.Submit"
                   StartIcon="@Icons.Material.Filled.Save"
                   form="@_formId">
            Guardar
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   FullWidth="false"
                   Color="Color.Default"
                   Size="Size.Medium"
                   ButtonType="ButtonType.Submit"
                   OnClick="@(() => Close())"
                   StartIcon="@Icons.Material.Filled.Close">
            Cerrar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public int ReporteId { get; set; }

    [CascadingParameter] IMudDialogInstance? MudDialog { get; set; }

    private readonly string _formId = $"form-{Guid.NewGuid()}";
    private ReporteEditDto _model = new ReporteEditDto() { Activo = true };

    protected override async Task OnInitializedAsync()
    {
        if (ReporteId != 0)
        {
            await InitialData();
        }
    }

    private async Task InitialData()
    {
        var result = await _reportesApi.GetReporteByIdAsync(ReporteId);
        if (result.Success)
        {
            _model = result.Data!;
        }
    }

    private async Task SaveSubmit()
    {
        try
        {
            if (ReporteId == 0)
            {
                var result = await _reportesApi.CreateReporteAsync(_model);
                if (result.Success)
                {
                    _snackbarService.Add(result.Message, Severity.Success);
                    MudDialog?.Close(DialogResult.Ok(true));
                }
                else
                {
                    _snackbarService.Add(result.Errors.FirstOrDefault() ?? "Error", Severity.Error);
                }
            }
            else
            {
                var result = await _reportesApi.UpdateReporteAsync(ReporteId, _model);
                if (result.Success)
                {
                    _snackbarService.Add(result.Message, Severity.Success);
                    MudDialog?.Close(DialogResult.Ok(true));
                }
                else
                {
                    _snackbarService.Add(result.Errors.FirstOrDefault() ?? "Error", Severity.Error);
                }
            }
        }
        catch (Exception ex)
        {
            _snackbarService.Add(ex.Message, Severity.Error);
        }
    }

    private void Close() => MudDialog?.Close(DialogResult.Ok(false));
}
