@using Yggdrasil.ApiClient.Contracts
@using Yggdrasil.ApiClient

@inject IReportesApi _reportesApi;

<MudDataGrid Outlined="true"
             Dense="true"
             Bordered="true"
             ServerData="GetTableData"
             FixedHeader="true"
             SortMode="SortMode.Single"
             @ref="dataGridRef"
             T="ReporteListItemDto">
    <ToolBarContent>
        <MudSpacer></MudSpacer>
        <div style="width:300px">
            <MudTextField T="string"
                          @bind-Value="@_searchText"
                          Margin="Margin.Dense"
                          Clearable="true"
                          Placeholder="Buscar.."></MudTextField>
        </div>
        <MudIconButton Size="MudBlazor.Size.Medium"
                       Icon="@Icons.Material.Filled.Search"
                       OnClick="()=>dataGridRef.ReloadServerData()"
                       Variant="Variant.Text"
                       Color="Color.Primary">
        </MudIconButton>
        <MudStack Row="true" AlignItems="AlignItems.End">
            <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => AddClick())" Color="Color.Primary">Agregar</MudButton>
        </MudStack>
    </ToolBarContent>
    <Columns>
        <PropertyColumn Title="ID" Property="x => x.Id" StickyLeft="true" />
        <PropertyColumn Title="Nombre de Reporte" Property="x => x.NomReporte" />
        <PropertyColumn Title="Procedimiento" Property="x => x.StoredProcedure" />
        <PropertyColumn Title="Parámetros" Property="x => x.Parametros" />
        <TemplateColumn Title="Activo">
            <CellTemplate>
                <MudCheckBox Value="@context.Item.Activo" T="bool" ReadOnly="true" Color="Color.Primary"></MudCheckBox>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn HeaderStyle="white-space:nowrap;width:150px;" StickyRight="true" Resizable="false" Title="Acciones">
            <CellTemplate>
                <MudStack Row="true" Justify="Justify.FlexEnd">
                    <MudTooltip Text="Configurar Parámetros">
                        <MudIconButton Size="@MudBlazor.Size.Small"
                                       Icon="@Icons.Material.Filled.Settings"
                                       Color="Color.Info"
                                       OnClick="()=>ConfigureParameters(context.Item.Id)" />
                    </MudTooltip>
                    <MudTooltip Text="Editar">
                        <MudIconButton Size="@MudBlazor.Size.Small"
                                       Icon="@Icons.Material.Outlined.Edit"
                                       Color="Color.Primary"
                                       OnClick="()=>EditClick(context.Item.Id)" />
                    </MudTooltip>
                    <MudTooltip Text="Eliminar">
                        <MudIconButton Size="@MudBlazor.Size.Small"
                                       Icon="@Icons.Material.Outlined.Delete"
                                       Color="Color.Error"
                                       OnClick="()=>DeleteClick(context.Item)" />
                    </MudTooltip>
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="ReporteListItemDto" />
    </PagerContent>
    <NoRecordsContent>
        <MudText>No hay registros de <strong>Reportes</strong></MudText>
    </NoRecordsContent>
</MudDataGrid>


@code {
    private string? _searchText;

    private MudDataGrid<ReporteListItemDto> dataGridRef = null!;
    private DialogOptions _optionsDialogs = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
    private DialogOptions _optionsDialogsLarge = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.Large, FullWidth = true };

    private async Task<GridData<ReporteListItemDto>> GetTableData(GridState<ReporteListItemDto> gridState, CancellationToken cancellationToken)
    {
        var _pageNumber = (gridState.Page + 1);
        var _sortBy = nameof(ReporteListItemDto.NomReporte);
        var _sortDescending = true;
        var _sortDefinitions = gridState.SortDefinitions.FirstOrDefault();
        if (_sortDefinitions != null)
        {
            _sortBy = _sortDefinitions.SortBy;
            _sortDescending = _sortDefinitions.Descending;
        }
        var paginatedList = await _reportesApi.GetReportesAsync(
            _searchText ?? string.Empty,
            _pageNumber,
            gridState.PageSize,
            _sortBy,
            _sortDescending
        );
        return new GridData<ReporteListItemDto>()
        {
            TotalItems = paginatedList.Data!.TotalCount,
            Items = paginatedList.Data!.Results
        };
    }

    private async Task AddClick()
    {
        var parameters = new DialogParameters { };
        var dialog = await _dialogService.ShowAsync<ReporteFormDialog>("Nuevo Reporte", parameters, _optionsDialogs);
        var result = await dialog.Result;
        if (!result!.Canceled)
        {
            await dataGridRef.ReloadServerData();
        }

    }

    private async Task EditClick(int id)
    {
        var parameters = new DialogParameters { { "ReporteId", id } };
        var dialog = await _dialogService.ShowAsync<ReporteFormDialog>("Editar Reporte", parameters, _optionsDialogs);
        var result = await dialog.Result;
        if (!result!.Canceled)
        {
            await dataGridRef.ReloadServerData();
        }

    }

    private async Task ConfigureParameters(int id)
    {
        var parameters = new DialogParameters { { "ReporteId", id } };
        var dialog = await _dialogService.ShowAsync<ParametrosDialog>("Configurar Parámetros", parameters, _optionsDialogsLarge);
        var result = await dialog.Result;
        if (!result!.Canceled)
        {
            await dataGridRef.ReloadServerData();
        }
    }

    private async Task DeleteClick(ReporteListItemDto item)
    {
        await _dialogService.ShowConfirmDialog($"¿Desea eliminar el Reporte {item.NomReporte} y sus parámetros?", "Eliminar", async (e) =>
        {
            try
            {
                var result = await _reportesApi.DeleteReporteAsync(item.Id);
                if (result.Success)
                {
                    await dataGridRef.ReloadServerData();
                    _snackbarService.Add(result.Message, MudBlazor.Severity.Success);
                }
                else
                {
                    _snackbarService.Add(result.Errors.FirstOrDefault() ?? "ERROR", MudBlazor.Severity.Error);
                }
            }
            catch (Exception ex)
            {
                _snackbarService.Add(ex.Message, MudBlazor.Severity.Error);
            }
        });
    }
}
